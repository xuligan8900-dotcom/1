          <string name="Name">TrapGeometry</string>
          <string name="Source"><![CDATA[--!strict
-- Sizes used by the factory and clearance regression tests (all in studs).
return table.freeze({
	SweepLength=6.2,
	SweepThickness=0.4,
	SweepHeight=1.25,
	BladeLength=2.8,
	BladeCenter=1.55,
	GearDiameter=5.8,
	GearToothRadius=3.15,
	-- Body clearance measured from the platform, excluding decorative piston rods.
	AvatarHeight=6,
	PressRestHeight=10,
	PressHalfHeight=0.75,
	DoorRestCenter=3.2,
	DoorHalfHeight=3,
})
