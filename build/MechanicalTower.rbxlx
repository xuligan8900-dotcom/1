      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">TrapMotion</string>
          <string name="Source"><![CDATA[--!strict
local Math=require(script.Parent.MotionMath)
local Motion = {}
function Motion.evaluate(model, now)
	local base=model:GetAttribute("Base")
	local t=now*model:GetAttribute("Speed")+model:GetAttribute("Phase")
	local direction=model:GetAttribute("Direction")
	local mode=model:GetAttribute("Motion")
	local amount,orbitZ,angle,state,danger=Math.sample(mode,t,
		model:GetAttribute("Safe"),model:GetAttribute("Warning"),model:GetAttribute("Active"),model:GetAttribute("Travel"))
	local cf=base
	if mode=="slide" or mode=="lift" or mode=="pulse" or mode=="press" then cf=base*CFrame.new(direction*amount)
	elseif mode=="orbit" then cf=base*CFrame.new(amount,0,orbitZ)
	elseif mode=="spin" or mode=="ring" or mode=="swing" then cf=base*CFrame.fromAxisAngle(direction,angle)
	elseif mode=="door" then cf=base*CFrame.new(0,amount,0)
	end
	return cf,state,danger
end
function Motion.apply(model, now)
	local cf,state,danger = Motion.evaluate(model,now)
	model:PivotTo(cf)
	if model:GetAttribute("VisualState") ~= state then
		model:SetAttribute("VisualState",state)
		for _,p in model:GetDescendants() do
			if p:IsA("BasePart") then
				if p:GetAttribute("Signal") then
					p.Color = if state == "warning" then Color3.fromRGB(255,190,40)
						elseif danger then Color3.fromRGB(255,65,70) else Color3.fromRGB(60,230,170)
				end
				if model:GetAttribute("Motion") == "fade" then
					p.CanCollide = state ~= "active" and p:GetAttribute("TowerSolid")==true
					p.CanQuery = p.CanCollide
					p.Transparency = if state == "active" then 0.92 elseif state == "warning" then 0.45 else 0.05
				end
			end
		end
	end
	return danger
end
return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Traversal</string>
          <string name="Source"><![CDATA[--!strict
-- Pure, deterministic walking paths. Mechanism nodes 2/6/10 stay isolated:
-- no bridge bypasses a moving/fading platform or its required landing jump.
local Traversal={}
local edges={{0,1},{3,4},{4,5},{7,8},{8,9},{11,12}}
function Traversal.width(stage)
	if stage.Traversal=="needles" then return 0.95 end
	if stage.Traversal=="pipes" then return 1.35 end
	return if stage.Id<=20 then 1.5 else 1.25
end
function Traversal.node(stage,node,baseWidth,baseDepth)
	local style=stage.Traversal or "jumps"
	if node%2==0 or style=="jumps" then return baseWidth,baseDepth,"deck" end
	if style=="posts" then
		local diameter=if stage.Id<30 then 2.8 else 2.5
		return diameter,diameter,"post"
	end
	-- Preserve flat waiting pads immediately before each trap.
	if node%4==1 then return math.max(3,baseWidth),baseDepth,"deck" end
	if style=="wrap" then return 3.2,2.5,"deck" end
	local width=Traversal.width(stage)
	return width,math.max(width,1.5),"joint"
end
local function interpolate(a,b,t,offset)
	local x=a.x+(b.x-a.x)*t
	local z=a.z+(b.z-a.z)*t
	local length=math.sqrt(x*x+z*z)
	return {x=x+x/length*offset,y=a.y+(b.y-a.y)*t,z=z+z/length*offset}
end
function Traversal.paths(stage,route)
	local style=stage.Traversal or "jumps"
	if style=="jumps" or style=="posts" then return {} end
	local result={}
	for index,edge in edges do
		local ax,ay,az=route.point(stage.Id,edge[1],stage.Layout)
		local bx,by,bz=route.point(stage.Id,edge[2],stage.Layout)
		local a,b={x=ax,y=ay,z=az},{x=bx,y=by,z=bz}
		local points={a}
		local column=nil
		if style=="zigzag" then
			table.insert(points,interpolate(a,b,0.5,if index%2==0 then -1.8 else 1.8))
		elseif style=="wrap" and edge[1]%4==3 then
			table.insert(points,interpolate(a,b,0.28,3.6))
			table.insert(points,interpolate(a,b,0.72,3.6))
			column=interpolate(a,b,0.5,0)
		end
		table.insert(points,b)
		table.insert(result,{From=edge[1],To=edge[2],Points=points,Width=Traversal.width(stage),
			Shape=if style=="pipes" then "pipe" else "beam",Column=column})
	end
	return result
end
return table.freeze(Traversal)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="21">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="22">
      <Properties>
        <string name="Name">TowerServer</string>
      </Properties>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">BuildUtil</string>
          <string name="Source"><![CDATA[--!strict
local Util = {}
function Util.part(parent, name, size, cf, color, material, collide)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cf
	part.Color = color or Color3.fromRGB(58,65,80)
	part.Material = material or Enum.Material.Metal
	part.Anchored = true
	part.CanCollide = collide ~= false
	part.CanTouch = false
	part.CanQuery = part.CanCollide
	part:SetAttribute("TowerSolid",part.CanCollide)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end
function Util.label(part, text, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = UDim2.fromOffset(190,42)
	gui.StudsOffset = Vector3.new(0,4,0)
	gui.MaxDistance = 55
	gui.AlwaysOnTop = false
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.new(1,1,1)
	label.TextStrokeTransparency = 0.3
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Parent = gui
end
function Util.folder(parent,name)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end
return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">CheckpointService</string>
          <string name="Source"><![CDATA[--!strict
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Rules=require(Shared.ProgressRules)
local Recovery=require(script.Parent.RecoveryService)
local Economy=require(script.Parent.EconomyService)
local Clubs=require(script.Parent.ClubService)
local Service={}
function Service.publish(player,p)
	local stats=player:FindFirstChild("leaderstats") or Instance.new("Folder")
	stats.Name="leaderstats"
	stats.Parent=player
	local stage=stats:FindFirstChild("Stage") or Instance.new("IntValue")
	stage.Name="Stage"; stage.Value=p.MaxStage; stage.Parent=stats
	local best=stats:FindFirstChild("BestTime") or Instance.new("StringValue")
	best.Name="BestTime"; best.Value=if p.BestTime then string.format("%.1fs",p.BestTime) else "—"; best.Parent=stats
	Recovery.update(player,p)
	player:SetAttribute("RunStage",p.RunStage)
	player:SetAttribute("MaxStage",p.MaxStage)
	player:SetAttribute("Deaths",p.Deaths)
	player:SetAttribute("StartedAt",p.StartedAt)
	player:SetAttribute("FinishTime",p.FinishTime)
	player:SetAttribute("Won",p.Won)
	player:SetAttribute("Completed",p.Completed)
	player:SetAttribute("BestTime",p.BestTime)
	player:SetAttribute("FullRun",p.FullRun)
	player:SetAttribute("SavePending",p.Revision>p.SavedRevision)
end
local function inside(part,position,halfSize)
	local p=part.CFrame:PointToObjectSpace(position)
	return math.abs(p.X)<=halfSize.X and math.abs(p.Y)<=halfSize.Y and math.abs(p.Z)<=halfSize.Z
end
function Service.start(tower,data,remotes)
	local checkpoints={}
	local gates={}
	for n=1,50 do
		checkpoints[n]=tower.Checkpoints:FindFirstChild("Checkpoint_"..n)
		gates[n]={tower.RouteGates:FindFirstChild("Gate_"..n.."_4"),tower.RouteGates:FindFirstChild("Gate_"..n.."_8")}
	end
	local elapsed=0
	local connection
	connection=RunService.Heartbeat:Connect(function(dt)
		if not tower.Parent then connection:Disconnect(); return end
		elapsed+=dt
		if elapsed<0.1 then return end
		elapsed=0
		for player,p in data.Profiles do
			if not player.Parent or p.Won or p.Spawning then continue end
			local character=player.Character
			local root=character and character:FindFirstChild("HumanoidRootPart")
			local humanoid=character and character:FindFirstChildOfClass("Humanoid")
			if not root or not humanoid or humanoid.Health<=0 then continue end
			local stage=p.RunStage+1
			local gate=gates[stage][p.Gate+1]
			if gate and inside(gate,root.Position,Vector3.new(4.5,3.5,3.5)) then p.Gate+=1 end
			local checkpoint=checkpoints[stage]
			local relative=checkpoint.CFrame:PointToObjectSpace(root.Position)
			local touching=Rules.onPad(relative.X,relative.Y,relative.Z,checkpoint.Size.X,checkpoint.Size.Z)
			if touching and Rules.canCheckpoint(p,stage) then
				Rules.advance(p,stage,os.clock())
				player.RespawnLocation=checkpoint
				Clubs.protect(player,2)
				if p.Won then
					p.FinishTime=workspace:GetServerTimeNow()-p.StartedAt
					if p.FullRun then p.BestTime=math.min(p.BestTime or math.huge,p.FinishTime) end
				end
				data.mark(p)
				Service.publish(player,p)
				remotes.CheckpointNotification:FireClient(player,stage)
				local victoryCF=if p.Won then root.CFrame else nil
				task.spawn(function()
					Economy.stage(player,stage)
					if victoryCF then Economy.victory(player,victoryCF) end
				end)
				if p.Won then
					remotes.VictoryEvent:FireClient(player,p.FinishTime,p.FullRun)
					task.spawn(data.save,player)
				else data.requestSave(player) end
			end
		end
	end)
	return connection
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ClubService</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Catalog=require(Shared.CosmeticCatalog)
local Rules=require(Shared.CombatRules)
local Service={States={},Staggers={},Economy=nil,Data=nil,Tower=nil,Remotes=nil,Templates={}}
local function state(player)
	local s=Service.States[player]
	if not s then s={NextSwing=0,LastRequest=-10,ShieldUntil=0,ImmuneUntil=0}; Service.States[player]=s end
	return s
end
function Service.protect(player,seconds)
	state(player).ShieldUntil=os.clock()+seconds
	player:SetAttribute("ClubShieldUntil",workspace:GetServerTimeNow()+seconds)
end
local function body(player)
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	return character,root,humanoid
end
function Service.safe(player,root)
	local s=state(player)
	if os.clock()<s.ShieldUntil then return true end
	local p=Service.Data and Service.Data.Profiles[player]
	if not p or p.Won then return true end
	local lobby=Service.Tower.Foundation.LobbySpawn.CFrame:PointToObjectSpace(root.Position)
	if Rules.inBox(lobby.X,lobby.Y,lobby.Z,10,12,-2,9) then return true end
	local nearest=math.floor((root.Position.Y-8)/20)
	for n=math.max(1,nearest-1),math.min(50,nearest+1) do
		local cp=Service.Tower.Checkpoints:FindFirstChild("Checkpoint_"..n)
		local q=cp.CFrame:PointToObjectSpace(root.Position)
		if Rules.inBox(q.X,q.Y,q.Z,cp.Size.X/2+1.1,cp.Size.Z/2+1.1,-1,7) then return true end
	end
	for _,floor in Service.Tower.RecoveryFloors:GetChildren() do
		if p.RunStage>=floor:GetAttribute("UnlockStage") then
			local q=root.Position-floor.CatchDeck.Position
			if Rules.inBox(q.X,q.Y,q.Z,54,54,0.6,7.6) then return true end
		end
	end
	return false
end
local function part(tool,name,size,offset,color,material,handle)
	local p=Instance.new("Part")
	p.Name=name; p.Size=size; p.CFrame=offset
	p.Color=color; p.Material=material
	p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true
	p.Parent=tool
	if handle then
		local weld=Instance.new("WeldConstraint")
		weld.Part0=handle; weld.Part1=p; weld.Parent=p
	end
	return p
end
local function makeTool(item)
	local tool=Instance.new("Tool")
	tool.Name=item.Name
	tool.ToolTip="Клик / F / кнопка Удар — оттолкнуть игрока"
	tool.RequiresHandle=true; tool.CanBeDropped=false
	tool.Grip=CFrame.new(0,-0.65,0)*CFrame.Angles(math.rad(-15),0,0)
	tool:SetAttribute("TowerClub",true); tool:SetAttribute("ClubId",item.Id)
	local color=Color3.fromRGB(item.Color[1],item.Color[2],item.Color[3])
	local handle=part(tool,"Handle",Vector3.new(0.35,2.8,0.35),CFrame.identity,Color3.fromRGB(80,68,58),Enum.Material.Wood)
	local material=if item.Style=="wood" then Enum.Material.Wood elseif item.Style=="steel" or item.Style=="hammer" then Enum.Material.Metal else Enum.Material.Neon
	local head=part(tool,"Head",if item.Style=="hammer" then Vector3.new(1.8,0.9,0.9) else Vector3.new(0.75,1.5,0.75),CFrame.new(0,1.3,0),color,material,handle)
	if item.Style=="plasma" then head.Shape=Enum.PartType.Ball end
	if item.Style=="cosmic" then
		head.Shape=Enum.PartType.Ball
		for _,x in {-0.65,0.65} do
			local orb=part(tool,"OrbitOrb",Vector3.new(0.4,0.4,0.4),CFrame.new(x,1.4,0),color,Enum.Material.Neon,handle)
			orb.Shape=Enum.PartType.Ball
		end
	end
	for _,y in {0.7,1.85} do part(tool,"Band",Vector3.new(0.82,0.12,0.82),CFrame.new(0,y,0),color,material,handle) end
	return tool
end
function Service.sync(player,forceEquip)
	if not Service.Economy then return end
	local p=Service.Economy.Profiles[player]
	local character,_,humanoid=body(player)
	local backpack=player:FindFirstChildOfClass("Backpack")
	if not p or not backpack then return end
	local id=p.Wallet.Equipped.Club
	local item=Catalog.ById[id]
	if not item or item.Category~="Club" or not p.Wallet.Owned[id] then return end
	local existing=nil
	for _,container in {backpack,character} do
		if not container then continue end
		for _,tool in container:GetChildren() do
			if tool:IsA("Tool") and tool:GetAttribute("TowerClub") then
				if tool:GetAttribute("ClubId")==id and not existing then existing=tool else tool:Destroy() end
			end
		end
	end
	if not existing then existing=Service.Templates[id]:Clone(); existing.Parent=backpack; forceEquip=true end
	if forceEquip and humanoid and humanoid.Health>0 then humanoid:EquipTool(existing) end
end
local function equipped(player)
	local p=Service.Economy.Profiles[player]
	local character,root,humanoid=body(player)
	if not p or not character or not root or not humanoid or humanoid.Health<=0 then return nil end
	for _,tool in character:GetChildren() do
		if tool:IsA("Tool") and tool:GetAttribute("TowerClub") then
			local id=tool:GetAttribute("ClubId")
			local item=Catalog.ById[id]
			if item and item.Category=="Club" and p.Wallet.Owned[id] and p.Wallet.Equipped.Club==id then return tool,item,root,humanoid end
		end
	end
	return nil
end
function Service.request(player)
	local s=state(player)
	local now=os.clock()
	if now-s.LastRequest<0.1 then return end
	s.LastRequest=now
	local tool,item,root,humanoid=equipped(player)
	if not tool then return end
	if not Rules.canSwing(now,s.NextSwing,true,humanoid.Health>0,Service.safe(player,root),humanoid.PlatformStand) then return end
	s.NextSwing=now+item.Cooldown
	s.Pending={At=now+item.Windup,Tool=tool,Character=player.Character}
	player:SetAttribute("ClubCooldownUntil",workspace:GetServerTimeNow()+item.Cooldown)
	Service.Remotes.ClubSwing:FireAllClients(player.UserId,item.Id)
end
local function resolve(player,pending)
	local tool,item,root,attackerHumanoid=equipped(player)
	if not tool or attackerHumanoid.PlatformStand or tool~=pending.Tool or player.Character~=pending.Character or Service.safe(player,root) then return end
	local forward=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
	if forward.Magnitude<0.01 then return end
	forward=forward.Unit
	local best,bestRoot,bestHumanoid,bestDistance=nil,nil,nil,math.huge
	for _,target in Players:GetPlayers() do
		if target==player then continue end
		local character,targetRoot,humanoid=body(target)
		if not targetRoot or not humanoid or humanoid.Health<=0 or targetRoot.Anchored then continue end
		local delta=targetRoot.Position-root.Position
		local horizontal=Vector3.new(delta.X,0,delta.Z)
		if horizontal.Magnitude<0.05 then continue end
		local distance=delta.Magnitude
		if distance>item.Range or distance>=bestDistance then continue end
		local safe=Service.safe(target,targetRoot)
		local params=RaycastParams.new()
		params.FilterType=Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances={player.Character,character}
		params.RespectCanCollide=true
		params.CollisionGroup=root.CollisionGroup
		local visible=workspace:Raycast(root.Position+Vector3.new(0,0.5,0),delta,params)==nil
		if Rules.canHit(distance,delta.Y,forward:Dot(horizontal.Unit),item.Range,visible,false,safe,true,os.clock()<state(target).ImmuneUntil) then
			best,bestRoot,bestHumanoid,bestDistance=target,targetRoot,humanoid,distance
		end
	end
	if not best then return end
	local direction=Vector3.new(bestRoot.Position.X-root.Position.X,0,bestRoot.Position.Z-root.Position.Z).Unit
	local old=bestRoot.AssemblyLinearVelocity
	local desired=direction*item.Power+Vector3.new(0,math.max(old.Y,item.Lift),0)
	local previous=bestHumanoid.PlatformStand
	pcall(function() bestRoot:SetNetworkOwner(nil) end)
	bestHumanoid.PlatformStand=true
	bestRoot:ApplyImpulse((desired-old)*bestRoot.AssemblyMass)
	bestRoot:SetAttribute("ClubKnockbackUntil",workspace:GetServerTimeNow()+Rules.Stagger+0.1)
	state(best).ImmuneUntil=os.clock()+Rules.HitImmunity
	table.insert(Service.Staggers,{Root=bestRoot,Humanoid=bestHumanoid,Until=os.clock()+Rules.Stagger,Previous=previous})
	Service.Remotes.ClubHit:FireAllClients(player.UserId,best.UserId,bestRoot.Position,item.Id)
end
function Service.remove(player) Service.States[player]=nil end
function Service.start(tower,remotes,economy,data)
	Service.Tower=tower; Service.Remotes=remotes; Service.Economy=economy; Service.Data=data
	economy.Clubs=Service
	local templates=Instance.new("Folder")
	templates.Name="TowerClubTemplates"; templates.Parent=game:GetService("ServerStorage")
	for _,item in Catalog.Items do
		if item.Category=="Club" then
			local tool=makeTool(item); tool.Parent=templates
			Service.Templates[item.Id]=tool
		end
	end
	remotes.ClubAttack.OnServerEvent:Connect(function(player) Service.request(player) end)
	local elapsed=0
	local connection
	connection=RunService.Heartbeat:Connect(function(dt)
		if not tower.Parent then connection:Disconnect(); return end
		local now=os.clock()
		for player,s in Service.States do
			if s.Pending and s.Pending.At<=now then
				local pending=s.Pending; s.Pending=nil
				if player.Parent then resolve(player,pending) end
			end
		end
		for i=#Service.Staggers,1,-1 do
			local entry=Service.Staggers[i]
			if now>=entry.Until then
				if entry.Humanoid.Parent and entry.Humanoid.Health>0 then
					entry.Humanoid.PlatformStand=entry.Previous
					if not entry.Previous then entry.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
				end
				if entry.Root.Parent then pcall(function() entry.Root:SetNetworkOwnershipAuto() end) end
				table.remove(Service.Staggers,i)
			end
		end
		elapsed+=dt
		if elapsed>=0.2 then
			elapsed=0
			for _,player in Players:GetPlayers() do
				local _,root=body(player)
				if root then player:SetAttribute("ClubSafe",Service.safe(player,root)) end
			end
		end
	end)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">CoinService</string>
          <string name="Source"><![CDATA[--!strict
local RunService=game:GetService("RunService")
local Route=require(game:GetService("ReplicatedStorage").Shared.Route)
local Definitions=require(game:GetService("ReplicatedStorage").Shared.StageDefinitions)
local U=require(script.Parent.BuildUtil)
local Service={}
function Service.start(tower,economy,progress)
	local folder=U.folder(tower,"CollectibleCoins")
	local coins={}
	for _,stage in Definitions do
		for _,node in {4,8} do
			local x,y,z=Route.point(stage.Id,node,stage.Layout)
			local id=stage.Id.."_"..node
			local coin=U.part(folder,"Coin_"..id,Vector3.new(0.22,1.4,1.4),
				CFrame.new(x,y+2,z)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(255,210,60),Enum.Material.Neon,false)
			coin.Shape=Enum.PartType.Cylinder
			coin:SetAttribute("CoinId",id)
			coin:SetAttribute("Base",coin.CFrame)
			coin:SetAttribute("Stage",stage.Id)
			table.insert(coins,coin)
		end
	end
	local elapsed=0
	local connection
	connection=RunService.Heartbeat:Connect(function(dt)
		if not tower.Parent then connection:Disconnect(); return end
		elapsed+=dt
		if elapsed<0.2 then return end
		elapsed=0
		local day=math.floor(os.time()/86400)
		if tower:GetAttribute("CoinDay")~=day then tower:SetAttribute("CoinDay",day) end
		for player,p in economy.Profiles do
			local run=progress.Profiles[player]
			local character=player.Character
			local root=character and character:FindFirstChild("HumanoidRootPart")
			local humanoid=character and character:FindFirstChildOfClass("Humanoid")
			if not run or not root or not humanoid or humanoid.Health<=0 or p.Busy or p.Collecting then continue end
			for _,coin in coins do
				local id=coin:GetAttribute("CoinId")
				if coin:GetAttribute("Stage")>run.RunStage+1 then continue end
				if p.Wallet.Day==day and p.Wallet.Collected[id] then continue end
				if (root.Position-coin.Position).Magnitude<=3 then
					p.Collecting=true
					task.spawn(function()
						economy.change(player,{Kind="collect",Id=id,Day=day})
						p.Collecting=false
					end)
					break
				end
			end
		end
	end)
	return connection
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">CommerceConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Create Developer Products in this experience, then replace ONLY ProductId.
-- Zero intentionally disables a product; it is never used as a purchase target.
-- Robux prices come from Roblox; do not hardcode them in the UI.
return table.freeze({
	DataStoreName="MechanicalTower_Economy_v1",
	Products={
		{Key="coins_small",Name="250 монет",Coins=250,ProductId=0},
		{Key="coins_medium",Name="1000 монет",Coins=1000,ProductId=0},
		{Key="coins_large",Name="3000 монет",Coins=3000,ProductId=0},
	},
	-- Permanent club ownership uses Game Passes, not repeatable coin products.
	GamePasses={
		{Key="club_plasma",Name="Плазменная дубинка навсегда",ItemId="club_plasma",PassId=0},
		{Key="club_cosmic",Name="Космическая дубинка навсегда",ItemId="club_cosmic",PassId=0},
	},
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[--!strict
local Catalog=require(game:GetService("ReplicatedStorage").Shared.CosmeticCatalog)
local Cosmetic={}
local function color(rgb) return Color3.fromRGB(rgb[1],rgb[2],rgb[3]) end
local function marked(class,parent,name)
	local object=Instance.new(class)
	object.Name=name
	object:SetAttribute("TowerCosmetic",true)
	object.Parent=parent
	return object
end
function Cosmetic.apply(player,wallet)
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local head=character and character:FindFirstChild("Head")
	if not root or not head then return end
	for _,parent in {root,head} do
		for _,object in parent:GetChildren() do
			if object:GetAttribute("TowerCosmetic") then object:Destroy() end
		end
	end
	local trailId=wallet.Equipped.Trail
	if trailId~="trail_none" then
		local item=Catalog.ById[trailId]
		local a=marked("Attachment",root,"TowerTrailTop")
		a.Position=Vector3.new(0,0.4,0.65)
		local b=marked("Attachment",root,"TowerTrailBottom")
		b.Position=Vector3.new(0,-1,0.65)
		local trail=marked("Trail",root,"TowerTrail")
		trail.Attachment0=a; trail.Attachment1=b
		trail.Color=ColorSequence.new(color(item.Color),color(item.SecondColor or item.Color))
		trail.Transparency=NumberSequence.new(0.2,1)
		trail.Lifetime=0.45
		trail.MinLength=0.15
		trail.LightEmission=0.8
		trail.FaceCamera=true
	end
	local item=Catalog.ById[wallet.Equipped.Title]
	local gui=marked("BillboardGui",head,"TowerTitle")
	gui.Size=UDim2.fromOffset(180,25)
	gui.StudsOffset=Vector3.new(0,2.5,0)
	gui.MaxDistance=45
	local label=Instance.new("TextLabel")
	label.BackgroundTransparency=1
	label.Size=UDim2.fromScale(1,1)
	label.Text=item.Name
	label.TextColor3=color(item.Color)
	label.TextStrokeTransparency=0.35
	label.Font=Enum.Font.GothamBold
	label.TextSize=14
	label.Parent=gui
end
return Cosmetic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local DataStoreService=game:GetService("DataStoreService")
local MarketplaceService=game:GetService("MarketplaceService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Config=require(Shared.GameConfig)
local Catalog=require(Shared.CosmeticCatalog)
local Rules=require(Shared.EconomyRules)
local Receipts=require(Shared.ReceiptProcessor)
local Passes=require(Shared.PassProcessor)
local Commerce=require(script.Parent.CommerceConfig)
local Cosmetics=require(script.Parent.CosmeticService)
local persistent=not RunService:IsStudio() or Config.StudioPersistence
local store=if persistent then DataStoreService:GetDataStore(Commerce.DataStoreName) else nil
local Economy={Profiles={},Products={},Remotes=nil}
local byProduct={}
local byPass={}
for _,product in Commerce.Products do
	assert(product.ProductId>=0 and product.ProductId%1==0 and product.Coins>0 and product.Coins%1==0 and product.Coins<=Rules.MaxPack)
	if product.ProductId>0 then
		assert(not byProduct[product.ProductId],"Developer Product IDs must be unique")
		byProduct[product.ProductId]=product
	end
end
for _,pass in Commerce.GamePasses do
	local item=Catalog.ById[pass.ItemId]
	assert(pass.PassId>=0 and pass.PassId%1==0 and item and item.RequiredPass==pass.Key,"Invalid club Game Pass")
	if pass.PassId>0 then assert(not byPass[pass.PassId],"Duplicate Game Pass ID"); byPass[pass.PassId]=pass end
end
local function retry(operation)
	local message
	for attempt=1,3 do
		local ok,result=pcall(operation)
		if ok then return true,result end
		message=result
		if attempt<3 then task.wait(attempt) end
	end
	return false,message
end
function Economy.public(player)
	local p=Economy.Profiles[player]
	if not p then return {Ready=false} end
	local w=p.Wallet
	-- Never replicate receipt history to clients.
	return {Ready=true,Revision=w.Revision,Coins=w.Coins,Owned=w.Owned,Equipped=w.Equipped,Day=w.Day,Collected=w.Collected,
		Supporter=w.Supporter,WinRewarded=w.WinRewarded,Products=Economy.Products,Persistent=persistent}
end
function Economy.publish(player)
	local p=Economy.Profiles[player]
	if not p or not player.Parent then return end
	player:SetAttribute("Coins",p.Wallet.Coins)
	player:SetAttribute("CosmeticTrail",p.Wallet.Equipped.Trail)
	player:SetAttribute("CosmeticVictory",p.Wallet.Equipped.Victory)
	player:SetAttribute("CosmeticTitle",p.Wallet.Equipped.Title)
	player:SetAttribute("EquippedClub",p.Wallet.Equipped.Club)
	Economy.Remotes.ShopStateChanged:FireClient(player,Economy.public(player))
	local signature=p.Wallet.Equipped.Trail..p.Wallet.Equipped.Title
	if signature~=p.Appearance then Cosmetics.apply(player,p.Wallet); p.Appearance=signature end
	if Economy.Clubs then Economy.Clubs.sync(player) end
end
function Economy.load(player)
	local saved=nil
	if store then
		local ok,value=retry(function() return store:GetAsync("u_"..player.UserId) end)
		if not ok then
			warn("[Economy] Load failed: "..tostring(value))
			if player.Parent then player:Kick("Could not load coins and inventory. Please rejoin; no data was overwritten.") end
			return false
		end
		saved=value
	end
	if not player.Parent then return false end
	Economy.Profiles[player]={Wallet=Rules.sanitize(saved,Catalog),Busy=false,LastRequest=-10}
	Economy.publish(player)
	return true
end
function Economy.change(player,command)
	local p=Economy.Profiles[player]
	if not p then return false,"not_loaded" end
	local deadline=os.clock()+12
	while p.Busy do
		if os.clock()>deadline or not player.Parent then return false,"busy" end
		task.wait(0.05)
	end
	if Economy.Profiles[player]~=p then return false,"not_loaded" end
	p.Busy=true
	local status="invalid"
	local ok,state
	if store then
		ok,state=retry(function()
			return store:UpdateAsync("u_"..player.UserId,function(old)
				local nextState,result=Rules.apply(old,command,Catalog)
				status=result
				return nextState
			end)
		end)
	else
		ok,state=pcall(function()
			local nextState,result=Rules.apply(p.Wallet,command,Catalog)
			status=result
			return nextState
		end)
	end
	p.Busy=false
	if not ok then warn("[Economy] Transaction pending: "..tostring(state)); return false,"save_failed" end
	p.Wallet=state
	Economy.publish(player)
	return true,status
end
function Economy.stage(player,stage)
	return Economy.change(player,{Kind="stage",Stage=stage})
end
function Economy.victory(player,cf)
	Economy.change(player,{Kind="win"})
	local p=Economy.Profiles[player]
	if p and player.Parent then Economy.Remotes.CosmeticVictory:FireAllClients(player.UserId,cf,p.Wallet.Equipped.Victory) end
end
function Economy.character(player,character)
	local p=Economy.Profiles[player]
	if not p then return end
	if character:WaitForChild("Head",15) and character:WaitForChild("HumanoidRootPart",15) and player.Character==character then
		Cosmetics.apply(player,p.Wallet)
		if Economy.Clubs then player:WaitForChild("Backpack",10); Economy.Clubs.sync(player,true) end
	end
end
function Economy.refreshPasses(player,force)
	local p=Economy.Profiles[player]
	if not p or RunService:IsStudio() or not store then return end
	if p.PassCheckRunning then
		if not force then return end
		local deadline=os.clock()+10
		while p.PassCheckRunning and os.clock()<deadline do task.wait(0.1) end
		if p.PassCheckRunning then return end
	end
	if not force and os.clock()-(p.LastPassCheck or -100)<15 then return end
	p.LastPassCheck=os.clock(); p.PassCheckRunning=true
	for passId,pass in byPass do
		if not p.Wallet.Owned[pass.ItemId] then
			local granted,result=Passes.process(pass,function(id)
				local ok,owns=retry(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId,id) end)
				if not ok then error(tostring(owns)) end
				return owns
			end,function(command)
				if Economy.Profiles[player]~=p then return false,"not_loaded" end
				return Economy.change(player,command)
			end)
			if not granted and result~="not_owned" then warn("[Commerce] Game Pass verification pending: "..passId.." ("..result..")") end
		end
	end
	p.PassCheckRunning=false
end
function Economy.remove(player)
	-- All balance/inventory changes are already durable UpdateAsync transactions.
	Economy.Profiles[player]=nil
end
local notices={requires_pass="Эта дубинка открывается покупкой Game Pass",not_enough_coins="Недостаточно монет",requires_win="Сначала покорите 50-й этап",requires_support="Титул выдаётся за поддержку проекта",not_owned="Сначала купите предмет",save_failed="Не удалось сохранить. Попробуйте ещё раз",busy="Покупка обрабатывается"}
function Economy.start(remotes)
	Economy.Remotes=remotes
	local context={Products=byProduct,Durable=store~=nil,
		GetPlayer=function(id) return Players:GetPlayerByUserId(id) end,
		IsLoaded=function(player) return Economy.Profiles[player]~=nil end,
		Grant=Economy.change}
	MarketplaceService.ProcessReceipt=function(receipt)
		local decision,status=Receipts.process(receipt,context)
		if decision=="PurchaseGranted" and status=="ok" then
			local player=Players:GetPlayerByUserId(receipt.PlayerId)
			if player then remotes.ShopNotice:FireClient(player,"Покупка подтверждена · "..byProduct[receipt.ProductId].Coins.." монет") end
		end
		return Enum.ProductPurchaseDecision[decision]
	end
	remotes.ShopGetState.OnServerInvoke=function(player) task.spawn(Economy.refreshPasses,player,false); return Economy.public(player) end
	remotes.ShopRequest.OnServerEvent:Connect(function(player,action,id)
		local p=Economy.Profiles[player]
		if not p or type(action)~="string" or type(id)~="string" or #id>64 or os.clock()-p.LastRequest<0.6 then return end
		p.LastRequest=os.clock()
		if action=="donate" then
			for _,product in Economy.Products do
				if product.Key==id and product.Enabled then
					if product.ItemId and p.Wallet.Owned[product.ItemId] then remotes.ShopNotice:FireClient(player,"Дубинка уже есть в коллекции"); return end
					local ok=pcall(function()
						if product.Type=="Pass" then MarketplaceService:PromptGamePassPurchase(player,product.PassId)
						else MarketplaceService:PromptProductPurchase(player,product.ProductId) end
					end)
					if not ok then remotes.ShopNotice:FireClient(player,"Покупка сейчас недоступна") end
					return
				end
			end
			remotes.ShopNotice:FireClient(player,"Покупка пока недоступна")
		elseif action=="buy" or action=="equip" then
			if not Catalog.ById[id] then return end
			local ok,result=Economy.change(player,{Kind=action,Id=id})
			remotes.ShopNotice:FireClient(player,if ok and result=="ok" then "Предмет выбран" else notices[result] or "Операция недоступна")
		end
	end)
	-- Zero IDs stay visible but disabled. No invented prices or fake successful sales.
	for _,product in Commerce.Products do
		table.insert(Economy.Products,{Key=product.Key,Name=product.Name,Coins=product.Coins,ProductId=product.ProductId,Type="Product",Enabled=false})
	end
	for _,pass in Commerce.GamePasses do
		table.insert(Economy.Products,{Key=pass.Key,Name=pass.Name,ItemId=pass.ItemId,PassId=pass.PassId,Type="Pass",Enabled=false})
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player,passId,purchased)
		local pass=byPass[passId]
		if not purchased or not pass then return end
		task.spawn(function()
			Economy.refreshPasses(player,true)
			local p=Economy.Profiles[player]
			if p and player.Parent then
				remotes.ShopNotice:FireClient(player,if p.Wallet.Owned[pass.ItemId] then "Дубинка добавлена в коллекцию" else "Выдача задерживается. Откройте магазин чуть позже.")
			end
		end)
	end)
	task.spawn(function()
		for _,product in Economy.Products do
			local id=if product.Type=="Pass" then product.PassId else product.ProductId
			if id>0 and not RunService:IsStudio() and game.GameId>0 then
				local infoType=if product.Type=="Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
				local ok,info=pcall(function() return MarketplaceService:GetProductInfoAsync(id,infoType) end)
				if ok and type(info)=="table" and type(info.PriceInRobux)=="number" and info.IsForSale~=false then
					product.Price=info.PriceInRobux
					product.Enabled=true
				else warn("[Commerce] Offer metadata unavailable: "..id) end
			end
		end
		for player in Economy.Profiles do Economy.publish(player) end
	end)
end
return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">GameBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
Players.CharacterAutoLoads=false
workspace:SetAttribute("TowerVersion","7.5")
workspace:SetAttribute("TowerBootStatus","starting")
workspace:SetAttribute("TowerBootError",nil)
workspace:SetAttribute("TowerDiagnosticsPassed",nil)
local function start()
	local ReplicatedStorage=game:GetService("ReplicatedStorage")
	workspace:SetAttribute("TowerBootStatus","modules")
	local Generator=require(script.Parent.TowerGenerator)
	local Traps=require(script.Parent.TrapController)
	local Data=require(script.Parent.PlayerDataService)
	local Economy=require(script.Parent.EconomyService)
	local Coins=require(script.Parent.CoinService)
	local Clubs=require(script.Parent.ClubService)
	local Checkpoints=require(script.Parent.CheckpointService)
	local Respawn=require(script.Parent.RespawnService)
	local Rules=require(ReplicatedStorage.Shared.ProgressRules)
	local remotes=Instance.new("Folder")
	remotes.Name="Remotes"
	for _,name in {"CheckpointNotification","VictoryEvent","PlayAgain","ShopRequest","ShopStateChanged","ShopNotice","CosmeticVictory","ClubAttack","ClubSwing","ClubHit"} do
		local event=Instance.new("RemoteEvent")
		event.Name=name
		event.Parent=remotes
	end
	local shopState=Instance.new("RemoteFunction")
	shopState.Name="ShopGetState"
	shopState.Parent=remotes
	remotes.Parent=ReplicatedStorage
	workspace:SetAttribute("TowerBootStatus","generating")
	local tower=Generator.generate()
	workspace:SetAttribute("TowerBootStatus","services")
	Economy.start(remotes)
	Clubs.start(tower,remotes,Economy,Data)
	Coins.start(tower,Economy,Data)
	Traps.start(tower)
	Checkpoints.start(tower,Data,remotes)
	Data.start()
	local connections={}
	local joining={}
	local function join(player)
		if joining[player] then return end
		joining[player]=true
		local p=Data.load(player)
		if not p then joining[player]=nil; return end
		if not Economy.load(player) then joining[player]=nil; return end
		task.spawn(Economy.refreshPasses,player,false)
		task.spawn(function()
			Economy.stage(player,p.MaxStage)
			if p.Completed then Economy.change(player,{Kind="win"}) end
		end)
		Checkpoints.publish(player,p)
		connections[player]=Respawn.bind(player,p,tower,Checkpoints.publish)
		player:SetAttribute("DataLoaded",true)
		Respawn.spawn(player,p,tower)
	end
	Players.PlayerAdded:Connect(join)
	Players.PlayerRemoving:Connect(function(player)
		local profile=Data.Profiles[player]
		if profile and profile.CollisionConnection then profile.CollisionConnection:Disconnect() end
		if connections[player] then connections[player]:Disconnect(); connections[player]=nil end
		Data.save(player,os.clock()+15)
		Data.Profiles[player]=nil
		Economy.remove(player)
		Clubs.remove(player)
		joining[player]=nil
	end)
	for _,player in Players:GetPlayers() do task.spawn(join,player) end
	remotes.PlayAgain.OnServerEvent:Connect(function(player)
		local p=Data.Profiles[player]
		if not p or p.Spawning or not Rules.replay(p,workspace:GetServerTimeNow(),os.clock()) then return end
		Checkpoints.publish(player,p)
		player.RespawnLocation=tower.Foundation.LobbySpawn
		Clubs.protect(player,4)
		local character=player.Character
		local humanoid=character and character:FindFirstChildOfClass("Humanoid")
		if character and humanoid and humanoid.Health>0 then
			local root=character:FindFirstChild("HumanoidRootPart")
			if root then root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero end
			character:PivotTo(Respawn.destination(tower,0))
		else Respawn.spawn(player,p,tower) end
	end)
	print("[Tower] Server initialized. Characters spawn only after deterministic generation and data loading.")

	workspace:SetAttribute("TowerBootStatus","ready")
	-- Diagnostics still execute and report failure, but a diagnostic assertion must
	-- not strand all players with CharacterAutoLoads=false before join is bound.
	if game:GetService("RunService"):IsStudio() then
		task.defer(function()
			local ok,result=xpcall(function()
				return require(game:GetService("ServerStorage").TowerTests.Smoke).run(tower)
			end,debug.traceback)
			workspace:SetAttribute("TowerDiagnosticsPassed",ok and result==true)
			if not ok then
				warn("[StudioSmoke] FAILED (game started; see diagnostic traceback): "..tostring(result))
			end
		end)
	end
end
local ok,err=xpcall(start,debug.traceback)
if not ok then
	local phase=workspace:GetAttribute("TowerBootStatus")
	workspace:SetAttribute("TowerBootError",tostring(err))
	workspace:SetAttribute("TowerBootStatus","failed")
	warn("[Tower] STARTUP FAILED at "..tostring(phase)..": "..tostring(err))
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[--!strict
local DataStoreService=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local Config=require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Schema=require(game:GetService("ReplicatedStorage").Shared.DataSchema)
local Data={Profiles={}, Closing=false}
local persistent=not RunService:IsStudio() or Config.StudioPersistence
local store=if persistent then DataStoreService:GetDataStore(Config.DataStoreName) else nil
local function retry(operation, deadline)
	local lastError
	for attempt=1,4 do
		if deadline and os.clock()>deadline then break end
		local ok,result=pcall(operation)
		if ok then return true,result end
		lastError=result
		if attempt<4 then task.wait(math.min(2^(attempt-1),4)) end
	end
	return false,lastError
end
function Data.load(player)
	local saved={MaxStage=0,Completed=false}
	if store then
		local ok,value=retry(function() return store:GetAsync("u_"..player.UserId) end)
		if not ok then
			warn("[Data] Load failed for "..player.UserId..": "..tostring(value))
			if player.Parent then player:Kick("Progress could not be loaded. Please rejoin; your saved progress is safe.") end
			return nil -- Never overwrite existing data with defaults after a failed load.
		end
		saved=Schema.sanitize(value)
	end
	if not player.Parent then return nil end
	local profile={MaxStage=saved.MaxStage,Completed=saved.Completed,BestTime=saved.BestTime,
		RunStage=saved.MaxStage,Deaths=0,StartedAt=workspace:GetServerTimeNow(),
		FullRun=saved.MaxStage==0,Won=saved.MaxStage==50,Revision=0,SavedRevision=0,
		Saving=false,LastSave=0,Gate=0,StageEntered=os.clock(),LastReplay=0}
	Data.Profiles[player]=profile
	player:SetAttribute("Persistence",persistent)
	return profile
end
function Data.mark(profile)
	profile.Revision+=1
end
function Data.save(player,deadline)
	local profile=Data.Profiles[player]
	if not profile then return true end
	while profile.Saving do
		if deadline and os.clock()>deadline then return false end
		task.wait(0.1)
	end
	if profile.SavedRevision>=profile.Revision then return true end
	if not store then profile.SavedRevision=profile.Revision; return true end
	profile.Saving=true
	local revision=profile.Revision
	local snapshot={MaxStage=profile.MaxStage,Completed=profile.Completed,BestTime=profile.BestTime}
	local ok,result=retry(function()
		return store:UpdateAsync("u_"..player.UserId,function(old)
			return Schema.merge(old,snapshot)
		end)
	end,deadline)
	profile.Saving=false
	profile.LastSave=os.clock()
	if ok then profile.SavedRevision=revision
	else warn("[Data] Save pending for "..player.UserId..": "..tostring(result)) end
	if player.Parent then player:SetAttribute("SavePending",profile.SavedRevision<profile.Revision) end
	return ok
end
function Data.requestSave(player)
	local profile=Data.Profiles[player]
	if not profile or profile.Queued then return end
	profile.Queued=true
	task.delay(Config.SaveDebounce,function()
		profile.Queued=false
		if Data.Profiles[player] and not Data.Closing then Data.save(player) end
	end)
end
function Data.start()
	if not persistent then warn("[Data] Studio session-only mode. Set StudioPersistence=true on a separate published test place to test DataStore.") end
	task.spawn(function()
		while not Data.Closing do
			task.wait(Config.SaveInterval)
			for player in Data.Profiles do
				if not Data.Closing then task.spawn(Data.save,player) end
			end
		end
	end)
	game:BindToClose(function()
		Data.Closing=true
		local deadline=os.clock()+25
		local pending=0
		for player in Data.Profiles do
			pending+=1
			task.spawn(function() Data.save(player,deadline); pending-=1 end)
		end
		while pending>0 and os.clock()<deadline do task.wait(0.1) end
		if pending>0 then warn("[Data] Shutdown save deadline reached; "..pending.." writes unfinished") end
	end)
end
return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">RecoveryService</string>
          <string name="Source"><![CDATA[--!strict
local PhysicsService=game:GetService("PhysicsService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Rules=require(Shared.RecoveryRules)
local Route=require(Shared.Route)
local Config=require(Shared.GameConfig)
local Definitions=require(Shared.StageDefinitions)
local U=require(script.Parent.BuildUtil)
local Recovery={}
function Recovery.configure()
	for section=0,Rules.FloorCount do
		local name=Rules.playerGroup(section)
		if not PhysicsService:IsCollisionGroupRegistered(name) then PhysicsService:RegisterCollisionGroup(name) end
	end
	for floor=1,Rules.FloorCount do
		local name=Rules.floorGroup(floor)
		if not PhysicsService:IsCollisionGroupRegistered(name) then PhysicsService:RegisterCollisionGroup(name) end
		PhysicsService:CollisionGroupSetCollidable(name,"Default",false)
		for section=0,Rules.FloorCount do
			PhysicsService:CollisionGroupSetCollidable(name,Rules.playerGroup(section),Rules.canStandOn(section,floor))
		end
	end
end
function Recovery.update(player,profile)
	local section=Rules.section(profile.RunStage)
	player:SetAttribute("RecoveryStage",section*Rules.Interval)
	local character=player.Character
	if not character or character:GetAttribute("TowerSection")==section then return end
	character:SetAttribute("TowerSection",section)
	for _,part in character:GetDescendants() do
		if part:IsA("BasePart") then part.CollisionGroup=Rules.playerGroup(section) end
	end
end
function Recovery.bindCharacter(player,profile,character)
	if profile.CollisionConnection then profile.CollisionConnection:Disconnect() end
	Recovery.update(player,profile)
	profile.CollisionConnection=character.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then part.CollisionGroup=Rules.playerGroup(Rules.section(profile.RunStage)) end
	end)
end
function Recovery.build(tower)
	for floor=1,Rules.FloorCount do
		local completed=floor*Rules.Interval
		local height=Rules.floorHeight(floor)
		local model=Instance.new("Model")
		model.Name="Recovery_"..completed
		model:SetAttribute("UnlockStage",completed)
		model:SetAttribute("FloorHeight",height)
		model.Parent=tower.RecoveryFloors
		local accent=Config.ZoneColors[math.ceil(completed/10)]
		local deck=U.part(model,"CatchDeck",Vector3.new(108,1.2,108),CFrame.new(0,height-0.6,0),Color3.fromRGB(104,116,132),Enum.Material.DiamondPlate)
		for _,edge in {-53,53} do
			U.part(model,"SafetyRail",Vector3.new(1,3,108),CFrame.new(edge,height+1.5,0),accent)
			U.part(model,"SafetyRail",Vector3.new(106,3,1),CFrame.new(0,height+1.5,edge),accent)
		end
		-- Rejoin node 8 of the completed stage: only 3.33 studs above the floor.
		-- Two broad steps approach it radially, without teleporting a fallen player.
		local x,y,z=Route.point(completed,8,Definitions[completed].Layout)
		local outward=Vector3.new(x,0,z).Unit
		local endpoint=Vector3.new(x,y,z)
		for step=1,2 do
			local top=height+(y-height)*step/3
			local position=endpoint+outward*((3-step)*4)
			U.part(model,"ReturnStep_"..step,Vector3.new(5,1,5),CFrame.new(position.X,top-0.5,position.Z),accent)
		end
		local sign=U.part(model,"ReturnMarker",Vector3.new(1,0.15,1),CFrame.new(x,height+0.15,z)+outward*10,accent,Enum.Material.Neon,false)
		U.label(sign,string.format("SAFETY FLOOR · %d–%d\n⇧ STAIRS → CHECKPOINT %d",completed+1,math.min(completed+5,50),completed),accent)
		U.label(deck,string.format("RECOVERY %d\nFALLS STOP HERE AFTER CHECKPOINT %d",completed,completed),accent)
		for _,part in model:GetDescendants() do
			if part:IsA("BasePart") then part.CollisionGroup=Rules.floorGroup(floor) end
		end
	end
end
return Recovery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">RespawnService</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Config=require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Recovery=require(script.Parent.RecoveryService)
local Economy=require(script.Parent.EconomyService)
local Clubs=require(script.Parent.ClubService)
local Respawn={}
function Respawn.destination(tower,stage)
	if stage==0 then return CFrame.new(42,12,0) end
	return tower.Checkpoints:FindFirstChild("Checkpoint_"..stage):GetAttribute("Spawn")
end
function Respawn.spawn(player,profile,tower)
	if profile.Spawning or not player.Parent then return end
	profile.Spawning=true
	player.RespawnLocation=if profile.RunStage==0 then tower.Foundation.LobbySpawn else tower.Checkpoints:FindFirstChild("Checkpoint_"..profile.RunStage)
	local ok,err=pcall(function() player:LoadCharacterAsync() end)
	profile.Spawning=false
	if ok and player.Parent then Clubs.sync(player,true) end
	if not ok and player.Parent then
		warn("[Respawn] "..tostring(err))
		task.delay(3,function() if player.Parent then Respawn.spawn(player,profile,tower) end end)
	end
end
function Respawn.bind(player,profile,tower,publish)
	local connection=player.CharacterAdded:Connect(function(character)
		Recovery.bindCharacter(player,profile,character)
		local humanoid=character:WaitForChild("Humanoid",15)
		local root=character:WaitForChild("HumanoidRootPart",15)
		if not humanoid or not root or not player.Parent then return end
		humanoid.WalkSpeed=Config.WalkSpeed
		humanoid.UseJumpPower=true
		humanoid.JumpPower=Config.JumpPower
		profile.Gate=0
		profile.StageEntered=os.clock()
		root.AssemblyLinearVelocity=Vector3.zero
		root.AssemblyAngularVelocity=Vector3.zero
		root.CFrame=Respawn.destination(tower,profile.RunStage)
		Clubs.protect(player,4)
		humanoid.Died:Once(function()
			profile.Deaths+=1
			publish(player,profile)
			task.delay(3,function()
				if player.Parent and player.Character==character then Respawn.spawn(player,profile,tower) end
			end)
		end)
		task.spawn(Economy.character,player,character)
	end)
	return connection
end
return Respawn
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">StageBuilder</string>
          <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local Route = require(Shared.Route)
local U = require(script.Parent.BuildUtil)
local Traps = require(script.Parent.TrapFactory)
local Traversal=require(Shared.Traversal)
local Walk=require(script.Parent.TraversalBuilder)
local Builder = {}
local zoneMaterials={
	[1]=Enum.Material.Metal,
	[2]=Enum.Material.Ice,
	[3]=Enum.Material.Concrete,
	[4]=Enum.Material.Brick,
	[5]=Enum.Material.Glass,
}
function Builder.build(tower, definition)
	local id = definition.Id
	local stage = Instance.new("Model")
	stage.Name = string.format("Stage_%02d_%s",id,definition.Name)
	stage:SetAttribute("StageId",id)
	stage:SetAttribute("Traversal",definition.Traversal)
	stage.Parent = tower.Stages
	local accent = Config.ZoneColors[definition.Zone]
	local frames = {}
	for node=0,12 do
		local x,y,z = Route.point(id,node,definition.Layout)
		local nx,_,nz = Route.point(id,math.min(node+1,12),definition.Layout)
		local point = Vector3.new(x,y,z)
		local tangent = if node==12 then Vector3.new(-z,0,x).Unit else Vector3.new(nx-x,0,nz-z).Unit
		frames[node] = CFrame.lookAt(point,point+tangent)
	end
	for node=0,12 do
		if node==0 and id>1 then continue end -- Previous checkpoint is this stage's safe start.
		local cf = frames[node]
		local station = if node==2 then 1 elseif node==6 then 2 elseif node==10 then 3 else nil
		local kind = if station then definition.Traps[station] else nil
		local moving = kind=="move" or kind=="lift" or kind=="orbit" or kind=="gear" or kind=="fade" or kind=="timer" or kind=="conveyor"
		local width,depth,shape=Traversal.node(definition,node,Route.width(id,node,definition.Layout),Route.depth(id,node))
		if not moving then
			local p
			if shape=="post" then p=Walk.post(stage,"Post_"..node,cf,width,accent)
			else p=U.part(stage,"Landing_"..node,Vector3.new(width,1,depth),cf*CFrame.new(0,-0.5,0)) end
			p.Material=zoneMaterials[definition.Zone] or Enum.Material.Metal
			p.Reflectance=if definition.Zone==5 then 0.12 else 0.04
			p:SetAttribute("ZoneMaterial",p.Material.Name)
			U.part(stage,"RouteLight",Vector3.new(0.15,0.08,depth-0.3),cf*CFrame.new(-width/2+0.15,0.05,0),accent,Enum.Material.Neon,false)
			if node%4==0 then
				-- Side rails leave both route ends open and never close the fall shafts.
				for side=-1,1,2 do
					U.part(stage,"RestRail",Vector3.new(0.25,2.5,2.3),cf*CFrame.new(side*(width/2+0.25),1.25,0),accent)
				end
			end
			if node==0 then U.label(p,string.format("%02d · %s\n⇧ FOLLOW THE LIGHTS",id,definition.Name),accent) end
		end
		if definition.Layout=="maze" and (node==3 or node==5 or node==7 or node==9) then
			local side=if node%4==1 then -1 else 1
			U.part(stage,"MazeFin",Vector3.new(0.5,4,4),cf*CFrame.new(side*(width/2-0.4),2,0),accent)
		end
		if station then Traps.create(stage,kind,cf,definition,station) end
		if node==4 or node==8 then
			local gate = U.part(tower.RouteGates,"Gate_"..id.."_"..node,Vector3.new(9,7,7),cf*CFrame.new(0,3,0),accent,nil,false)
			gate.Transparency=1
			gate.CanQuery=false
			gate:SetAttribute("Stage",id)
			gate:SetAttribute("Order",node/4)
		end
		if node==12 then
			local cp=Instance.new("SpawnLocation")
			cp.Name="Checkpoint_"..id
			cp.Size=Vector3.new(4.8,0.2,2.6)
			cp.CFrame=cf*CFrame.new(0,0.12,0)
			cp.Color=accent
			cp.Material=Enum.Material.Neon
			cp.Anchored=true
			cp.CanCollide=false
			cp.CanQuery=false
			cp.CanTouch=true
			cp.Neutral=true
			cp.Enabled=true
			cp.Duration=0
			cp.AllowTeamChangeOnTouch=false
			cp.Parent=tower.Checkpoints
			cp:SetAttribute("Stage",id)
			cp:SetAttribute("Spawn",cf*CFrame.new(0,4,0))
			U.label(cp,string.format("CHECKPOINT %02d / 50\n%s",id,definition.Name),accent)
		end
	end
	Walk.build(stage,definition,accent)
	-- A few industrial details per zone, all outside the jumping corridor.
	local x,y,z=Route.point(id,6,definition.Layout)
	U.part(stage,"ServicePipe",Vector3.new(0.6,13,0.6),CFrame.new(x*1.32,y+3,z*1.32),accent)
	return stage
end
return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">TowerGenerator</string>
          <string name="Source"><![CDATA[--!strict
local Lighting = game:GetService("Lighting")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GameConfig)
local Definitions = require(Shared.StageDefinitions)
local Route = require(Shared.Route)
local U = require(script.Parent.BuildUtil)
local Builder = require(script.Parent.StageBuilder)
local Recovery=require(script.Parent.RecoveryService)
local Generator = {}
function Generator.generate()
	Recovery.configure()
	Lighting.ClockTime=13.5
	Lighting.Brightness=3.2
	Lighting.Ambient=Color3.fromRGB(166,176,194)
	Lighting.OutdoorAmbient=Color3.fromRGB(194,204,219)
	Lighting.GlobalShadows=false
	local existing=workspace:FindFirstChild("GeneratedTower")
	if existing then
		assert(existing:GetAttribute("Ready"),"Previous incomplete tower exists; stop Play before rebuilding")
		return existing
	end
	Route.validate(Definitions)
	local tower=Instance.new("Model")
	tower.Name="GeneratedTower"
	tower:SetAttribute("Ready",false)
	-- Parent only when the complete map is ready; auto character loading is disabled by bootstrap.
	for _,name in {"Foundation","StructuralSupports","Stages","Checkpoints","KillZones","FinishArea","RouteGates","RecoveryFloors"} do U.folder(tower,name) end
	U.part(tower.Foundation,"Foundation",Vector3.new(108,4,108),CFrame.new(0,0,0),Color3.fromRGB(35,40,50),Enum.Material.Concrete)
	U.part(tower.Foundation,"Lobby",Vector3.new(16,6,18),CFrame.new(42,5,0))
	U.part(tower.Foundation,"LobbyStep1",Vector3.new(10,2,4),CFrame.new(42,3,-15))
	U.part(tower.Foundation,"LobbyStep2",Vector3.new(10,4,4),CFrame.new(42,4,-11))
	local spawn=Instance.new("SpawnLocation")
	spawn.Name="LobbySpawn"
	spawn.Size=Vector3.new(8,1,8)
	spawn.CFrame=CFrame.new(42,8,0)
	spawn.Anchored=true
	spawn.Neutral=true
	spawn.Duration=0
	spawn.Transparency=1
	spawn.CanCollide=false
	spawn.Enabled=true -- Each player explicitly selects this or a completed checkpoint as RespawnLocation.
	spawn.Parent=tower.Foundation
	U.label(spawn,"MEGA MECHANICAL TOWER\n50 STAGES · SAFETY FLOORS EVERY 5",Config.ZoneColors[1])
	for _,x in {-47,47} do for _,z in {-47,47} do
		U.part(tower.StructuralSupports,"MainColumn",Vector3.new(3,1010,3),CFrame.new(x,503,z))
		U.part(tower.StructuralSupports,"ColumnLight",Vector3.new(0.25,1008,0.25),CFrame.new(x-1.6,503,z-1.6),Config.ZoneColors[5],Enum.Material.Neon,false)
	end end
	for level=0,10 do
		local y=level*100+4
		for _,z in {-47,47} do U.part(tower.StructuralSupports,"CrossBeam",Vector3.new(97,1.5,2),CFrame.new(0,y,z)) end
		for _,x in {-47,47} do U.part(tower.StructuralSupports,"CrossBeam",Vector3.new(2,1.5,97),CFrame.new(x,y,0)) end
	end
	local kill=U.part(tower.KillZones,"BottomKillZone",Vector3.new(4000,5,4000),CFrame.new(0,-65,0),nil,nil,false)
	kill.Transparency=1
	kill.CanTouch=true
	kill.Touched:Connect(function(hit)
		local character=hit:FindFirstAncestorOfClass("Model")
		local humanoid=character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.Health=0 end
	end)
	for _,definition in Definitions do Builder.build(tower,definition) end
	local secrets=U.folder(tower,"SecretRooms")
	for index,cf in ipairs({CFrame.new(52,208,-18),CFrame.new(-54,508,16),CFrame.new(18,808,54)}) do
		local room=U.part(secrets,"SecretRoom_"..index,Vector3.new(12,1,12),cf,Config.ZoneColors[(index%5)+1],Enum.Material.Neon,true)
		room:SetAttribute("SecretRoom",true)
		U.label(room,"SECRET ROOM\n+25 COINS",Config.ZoneColors[5])
	end
	Recovery.build(tower)
	local finish=tower.Checkpoints:FindFirstChild("Checkpoint_50")
	local finishCF=finish.CFrame*CFrame.new(0,-0.12,-11)
	U.part(tower.FinishArea,"CrownDeck",Vector3.new(26,1,22),finishCF*CFrame.new(0,-0.5,0),Color3.fromRGB(26,30,42))
	for _,x in {-12.5,12.5} do U.part(tower.FinishArea,"ViewingRail",Vector3.new(0.4,3,20),finishCF*CFrame.new(x,1.5,0),Config.ZoneColors[5]) end
	local portal=U.part(tower.FinishArea,"VictoryPortal",Vector3.new(12,0.5,1),finishCF*CFrame.new(0,10,-6),Config.ZoneColors[5],Enum.Material.Neon,false)
	for _,x in {-6,6} do U.part(tower.FinishArea,"PortalPillar",Vector3.new(0.5,10,1),finishCF*CFrame.new(x,5,-6),Config.ZoneColors[5],Enum.Material.Neon,false) end
	U.label(portal,"YOU WIN!\nMASTER MECHANIC",Config.ZoneColors[5])
	local attachment=Instance.new("Attachment")
	attachment.Position=Vector3.new(0,-4,0)
	attachment.Parent=portal
	local confetti=Instance.new("ParticleEmitter")
	confetti.Name="Confetti"
	confetti.Enabled=false
	confetti.Rate=0
	confetti.Texture="rbxasset://textures/particles/sparkles_main.dds"
	confetti.Color=ColorSequence.new(Config.ZoneColors[3],Config.ZoneColors[5])
	confetti.Lifetime=NumberRange.new(2,4)
	confetti.Speed=NumberRange.new(12,24)
	confetti.SpreadAngle=Vector2.new(180,180)
	confetti.Acceleration=Vector3.new(0,-18,0)
	confetti.Parent=attachment
	for _,item in {"Atmosphere","BloomEffect","ColorCorrectionEffect"} do
		if not Lighting:FindFirstChild("Tower"..item) then
			local effect=Instance.new(item)
			effect.Name="Tower"..item
			if item=="Atmosphere" then effect.Density=0.07; effect.Offset=0.15
			elseif item=="BloomEffect" then effect.Intensity=0.35; effect.Size=24; effect.Threshold=1.4
			else effect.Contrast=0.02; effect.Saturation=0.06 end
			effect.Parent=Lighting
		end
	end
	assert(#tower.Stages:GetChildren()==Config.StageCount)
	assert(#tower.Checkpoints:GetChildren()==Config.StageCount)
	assert(#tower.RouteGates:GetChildren()==Config.StageCount*2)
	local lastY=-math.huge
	for i=1,Config.StageCount do
		local cp=tower.Checkpoints:FindFirstChild("Checkpoint_"..i)
		assert(cp and cp.Position.Y>lastY,"Invalid checkpoint height")
		lastY=cp.Position.Y
	end
	tower:SetAttribute("Ready",true)
	tower.Parent=workspace
	local parts=0
	for _,object in tower:GetDescendants() do if object:IsA("BasePart") then parts+=1 end end
	print(string.format("[Tower] READY: 50 stages, 50 checkpoints, 100 route gates, %d parts; top %.1f studs",parts,lastY))
	return tower
end
return Generator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">TrapController</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local CollectionService=game:GetService("CollectionService")
local Motion=require(game:GetService("ReplicatedStorage").Shared.TrapMotion)
local Controller={}
function Controller.start(tower)
	local mechanisms=CollectionService:GetTagged("TowerMechanism")
	local records={}
	for _,model in mechanisms do
		if model:IsDescendantOf(tower) then
			local hazards={}
			for _,p in model:GetDescendants() do
				if p:IsA("BasePart") and p:GetAttribute("Hazard") then table.insert(hazards,p) end
			end
			table.insert(records,{model=model,hazards=hazards})
		end
	end
	local elapsed=0
	local hitAt=setmetatable({},{__mode="k"})
	local connection
	connection=RunService.PreSimulation:Connect(function(dt)
		if not tower.Parent then connection:Disconnect(); return end
		elapsed+=dt
		if elapsed<1/30 then return end
		elapsed=0
		local now=workspace:GetServerTimeNow()
		local characters={}
		local heights={}
		local positions={}
		for _,player in Players:GetPlayers() do
			local character=player.Character
			local root=character and character:FindFirstChild("HumanoidRootPart")
			if root then table.insert(characters,character); table.insert(heights,root.Position.Y); table.insert(positions,root.Position) end
		end
		local params=OverlapParams.new()
		params.FilterType=Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances=characters
		for _,record in records do
			local model=record.model
			local near=false
			for _,height in heights do
				if math.abs(height-model:GetAttribute("Base").Position.Y)<130 then near=true; break end
			end
			if not near then continue end
			local danger=Motion.apply(model,now)
			for _,p in record.hazards do
				-- Inactive laser beams must also disappear on clients; motion is evaluated there too.
				if model:GetAttribute("Motion")=="gate" then
					p.Transparency=if danger then 0.05 elseif model:GetAttribute("VisualState")=="warning" then 0.65 else 0.95
				end
			end
			local damageNear=false
			for _,position in positions do
				if (position-model:GetAttribute("Base").Position).Magnitude<24 then damageNear=true; break end
			end
			if not danger or not damageNear then continue end
			for _,hazard in record.hazards do
				for _,hit in workspace:GetPartBoundsInBox(hazard.CFrame,hazard.Size,params) do
					local character=hit:FindFirstAncestorOfClass("Model")
					if character and hit.Parent~=character then continue end -- Cosmetic accessories do not enlarge the damage hitbox.
					local humanoid=character and character:FindFirstChildOfClass("Humanoid")
					local root=character and character:FindFirstChild("HumanoidRootPart")
					if not humanoid or humanoid.Health<=0 or now-(hitAt[humanoid] or 0)<0.6 then continue end
					hitAt[humanoid]=now
					local damage=model:GetAttribute("Damage")
					if damage>0 then humanoid:TakeDamage(damage) end
					if root and model:GetAttribute("Push")>0 then
						root:ApplyImpulse((model:GetAttribute("Base").RightVector*model:GetAttribute("Push")+Vector3.new(0,9,0))*root.AssemblyMass)
					end
				end
			end
		end
	end)
	print("[Tower] Central trap controller: "..#records.." mechanisms; 30 Hz, vertical activity culling")
	return connection
end
return Controller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">TrapFactory</string>
          <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.TrapDefinitions)
local U = require(script.Parent.BuildUtil)
local Difficulty=require(Shared.Difficulty)
local Route=require(Shared.Route)
local Geometry=require(Shared.TrapGeometry)
local Factory = {}
local metal = Color3.fromRGB(75,83,104)
local danger = Color3.fromRGB(255,75,70)
function Factory.create(parent, kind, surface, stage, station)
	local definition=Difficulty.trap(assert(Definitions[kind],"Unknown trap "..kind),stage,station)
	assert(definition.Size>0 and definition.Speed>0 and definition.Safe>0 and definition.Warning>0 and definition.Active>0)
	local model = Instance.new("Model")
	model.Name = kind .. "_" .. station
	model:SetAttribute("Kind",kind)
	model:SetAttribute("Stage",stage.Id)
	for key,value in definition do model:SetAttribute(key,value) end
	model:SetAttribute("Speed", definition.Speed)
	-- Some rooms share a clock; others have clearly staggered warnings.
	model:SetAttribute("Phase", if stage.Id == 30 or stage.Id == 47 then stage.Phase else stage.Phase + station * 1.35)
	local direction=Vector3.new(definition.DirectionX,definition.DirectionY,definition.DirectionZ)
	model:SetAttribute("Direction",if direction.Magnitude>0 then direction.Unit else Vector3.xAxis)
	local base = surface
	if kind == "press" then base *= CFrame.new(0,Geometry.PressRestHeight,0)
	elseif kind == "pendulum" then base *= CFrame.new(0,12,0)
	elseif kind == "pusher" then base *= CFrame.new(-6,2,0)
	elseif kind == "ring" then base *= CFrame.new(0,3.5,0)
	elseif kind == "door" then base *= CFrame.new(0,Geometry.DoorRestCenter,0)
	elseif kind == "laser" then base *= CFrame.new(0,2,0)
	elseif kind == "rotor" or kind == "doubleRotor" or kind == "blade" then base *= CFrame.new(0,Geometry.SweepHeight,0)
	end
	model:SetAttribute("Base",base)
	model.WorldPivot = base
	local function piece(name,size,localCF,hazard,carry,solid)
		local p = U.part(model,name,size,base*localCF,if hazard then danger else metal,
			if hazard then Enum.Material.Neon else Enum.Material.DiamondPlate,solid)
		p:SetAttribute("Hazard",hazard == true)
		p:SetAttribute("Carry",carry == true and definition.Carry)
		p:SetAttribute("Signal",hazard == true or kind == "fade" or kind == "timer")
		return p
	end
	if kind == "move" or kind == "lift" or kind == "orbit" or kind == "fade" or kind == "timer" or kind == "conveyor" then
		local deckWidth,deckDepth=Route.carrierSize(stage.Id)
		piece("Deck",Vector3.new(deckWidth,1,deckDepth),CFrame.new(0,-0.5,0),false,true,true)
		for x=-1,1,2 do
			piece("EdgeLight",Vector3.new(0.15,0.08,deckDepth-0.2),CFrame.new(x*(deckWidth/2-0.15),0.04,0),false,false,false).Color = Color3.fromRGB(70,220,255)
		end
		if kind == "lift" then
			piece("MovingColumn",Vector3.new(2.8,6,2.8),CFrame.new(0,-4,0),false,false,false)
		end
		if kind == "conveyor" then
			for z=-1,1 do
				local stripe = piece("BeltMark",Vector3.new(deckWidth-0.4,0.04,0.16),CFrame.new(0,0.05,z),false,false,false)
				stripe.Color = Color3.fromRGB(255,195,60)
			end
			U.label(model.Deck, "⇧ BELT ⇧",Color3.fromRGB(255,195,60))
		end
	elseif kind == "gear" then
		local deck = piece("GearDeck",Vector3.new(0.9,Geometry.GearDiameter,Geometry.GearDiameter),CFrame.new(0,-0.45,0)*CFrame.Angles(0,0,math.pi/2),false,true,true)
		deck.Shape = Enum.PartType.Cylinder
		for n=0,11 do
			local a=n*math.pi/6
			piece("Tooth",Vector3.new(0.7,0.65,0.9),CFrame.new(math.cos(a)*Geometry.GearToothRadius,-0.3,math.sin(a)*Geometry.GearToothRadius)*CFrame.Angles(0,-a,0),true,false,false)
		end
		piece("Sector",Vector3.new(1.5,0.08,4),CFrame.new(0,0.06,0),false,false,false).Color=Color3.fromRGB(60,230,170)
	elseif kind == "rotor" or kind == "doubleRotor" or kind == "blade" then
		piece("Axle",Vector3.new(0.6,2,0.6),CFrame.new(0,-1,0),false,false,false)
		if kind=="blade" then
			-- Three short paddles; no lethal upper bar or reach into the waiting pad.
			for index=0,2 do
				local angle=index*math.pi*2/3
				local offset=CFrame.new(math.cos(angle)*Geometry.BladeCenter,0,math.sin(angle)*Geometry.BladeCenter)*CFrame.Angles(0,-angle,0)
				piece(if index==0 then "Sweep" elseif index==1 then "CrossSweep" else "ThirdSweep",
					Vector3.new(Geometry.BladeLength,Geometry.SweepThickness,0.75),offset,true,false,false)
			end
		else
			piece("Sweep",Vector3.new(Geometry.SweepLength,Geometry.SweepThickness,0.45),CFrame.new(),true,false,false)
			if kind=="doubleRotor" then
				piece("CrossSweep",Vector3.new(0.45,Geometry.SweepThickness,Geometry.SweepLength),CFrame.new(),true,false,false)
			end
		end
	elseif kind == "pendulum" then
		piece("Shaft",Vector3.new(0.35,9,0.35),CFrame.new(0,-4.5,0),false,false,false)
		piece("Hammer",Vector3.new(if stage.Id>=34 then 4.2 else 3.5,2.2,2.5),CFrame.new(0,-9.5,0),true,false,false)
	elseif kind == "press" then
		piece("Piston",Vector3.new(1,5,1),CFrame.new(0,3,0),false,false,false)
		piece("Crusher",Vector3.new(7,1.5,4),CFrame.new(),true,false,true)
	elseif kind == "pusher" then
		piece("Ram",Vector3.new(1.2,3,3),CFrame.new(),true,false,true)
	elseif kind == "laser" then
		piece("Beam",Vector3.new(10,0.35,0.35),CFrame.new(),true,false,false)
	elseif kind == "ring" then
		for n=0,9 do
			local a=n*math.pi/6
			piece("Rim",Vector3.new(1.9,0.5,0.5),CFrame.new(math.cos(a)*3.7,math.sin(a)*3.7,0)*CFrame.Angles(0,0,a+math.pi/2),true,false,false)
		end
		piece("Spoke",Vector3.new(3.5,0.4,0.4),CFrame.new(1.75,0,0),true,false,false)
	elseif kind == "door" then
		piece("Shutter",Vector3.new(9,6,0.7),CFrame.new(),false,false,true)
	end
	local signal=piece("WarningStrip",Vector3.new(2,0.12,0.2),CFrame.new(0,0.15,2.8),false,false,false)
	signal.Material=Enum.Material.Neon
	signal:SetAttribute("Signal",true)
	if stage.Id%5==0 then
		local attachment=Instance.new("Attachment")
		attachment.Parent=signal
		local sparks=Instance.new("ParticleEmitter")
		sparks.Name="WarningSparks"
		sparks.Enabled=false
		sparks.Rate=0
		sparks.Texture="rbxasset://textures/particles/sparkles_main.dds"
		sparks.Color=ColorSequence.new(Color3.fromRGB(255,190,60))
		sparks.Lifetime=NumberRange.new(0.15,0.4)
		sparks.Speed=NumberRange.new(2,5)
		sparks.Parent=attachment
	end
	if definition.Size~=1 then model:ScaleTo(definition.Size) end
	model.Parent = parent
	model:AddTag("TowerMechanism")
	return model
end
return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">TraversalBuilder</string>
          <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage").Shared
local Traversal=require(Shared.Traversal)
local Route=require(Shared.Route)
local U=require(script.Parent.BuildUtil)
local Builder={}
local labels={rails="BALANCE BEAMS",needles="NEEDLE WALK",zigzag="ZIGZAG CATWALK",pipes="PIPE CROSSING",wrap="AROUND THE COLUMNS",posts="COLUMN HOPS"}
local function vector(p) return Vector3.new(p.x,p.y,p.z) end
function Builder.post(parent,name,cf,diameter,accent)
	local height=4
	local part=U.part(parent,name,Vector3.new(height,diameter,diameter),
		CFrame.new(cf.Position-Vector3.new(0,height/2,0))*CFrame.Angles(0,0,math.pi/2),accent,Enum.Material.Concrete)
	part.Shape=Enum.PartType.Cylinder
	part:SetAttribute("TraversalPost",true)
	return part
end
function Builder.build(parent,definition,accent)
	local style=definition.Traversal or "jumps"
	if style=="jumps" then return end
	local model=Instance.new("Model")
	model.Name="Traversal_"..style
	model:SetAttribute("Style",style)
	model.Parent=parent
	for index,path in Traversal.paths(definition,Route) do
		for segment=1,#path.Points-1 do
			local a,b=vector(path.Points[segment]),vector(path.Points[segment+1])
			local direction=(b-a).Unit
			local up=(Vector3.yAxis-direction*direction.Y).Unit
			local center=(a+b)/2
			local part
			if path.Shape=="pipe" then
				part=U.part(model,"Pipe_"..index.."_"..segment,
					Vector3.new((b-a).Magnitude+0.5,path.Width,path.Width),
					CFrame.fromMatrix(center-Vector3.yAxis*path.Width/2,direction,up,direction:Cross(up)),
					Color3.fromRGB(155,169,185))
				part.Shape=Enum.PartType.Cylinder
			else
				part=U.part(model,"Beam_"..index.."_"..segment,
					Vector3.new(path.Width,0.45,(b-a).Magnitude+0.5),
					CFrame.lookAt(center-Vector3.yAxis*0.225,b-Vector3.yAxis*0.225),Color3.fromRGB(155,169,185),Enum.Material.DiamondPlate)
			end
			part:SetAttribute("WalkWidth",path.Width)
			part:SetAttribute("TraversalSurface",true)
			-- A slim center light makes the route legible without widening collision.
			U.part(model,"CenterStripe",Vector3.new(0.08,0.04,(b-a).Magnitude),
				CFrame.lookAt(center+up*0.035,b+up*0.035),accent,Enum.Material.Neon,false)
		end
		for point=2,#path.Points-1 do
			local p=path.Points[point]
			U.part(model,"CornerJoint",Vector3.new(path.Width,0.45,path.Width),CFrame.new(p.x,p.y-0.225,p.z),accent)
		end
		if path.Column then
			local p=path.Column
			U.part(model,"RouteColumn",Vector3.new(1.2,7,1.2),CFrame.new(p.x,p.y+3.5,p.z),Color3.fromRGB(95,108,129))
		end
	end
	local x,y,z=Route.point(definition.Id,4,definition.Layout)
	local sign=U.part(model,"TraversalSign",Vector3.new(0.1,0.1,0.1),CFrame.new(x,y+2,z),accent,nil,false)
	sign.Transparency=1
	U.label(sign,labels[style].."\n⇧ FOLLOW THE CENTER LIGHT",accent)
end
return Builder
]]></string>
        </Properties>
      </Item>
    </Item>
