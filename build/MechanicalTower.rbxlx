  <Item class="ServerStorage" referent="39">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="40">
      <Properties>
        <string name="Name">TowerTests</string>
      </Properties>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Smoke</string>
          <string name="Source"><![CDATA[--!strict
-- Runs automatically only in Studio after generation. No production mutations.
local Test={}
function Test.run(tower)
	local Shared=game:GetService("ReplicatedStorage").Shared
	local Definitions=require(Shared.StageDefinitions)
	local Route=require(Shared.Route)
	local Motion=require(Shared.TrapMotion)
	local Recovery=require(Shared.RecoveryRules)
	local Geometry=require(Shared.TrapGeometry)
	local Numeric=require(Shared.Numeric)
	local Traversal=require(Shared.Traversal)
	local PhysicsService=game:GetService("PhysicsService")
	assert(Route.validate(Definitions))
	assert(#tower.RecoveryFloors:GetChildren()==9,"Missing catch floors")
	for floor=1,9 do
		local model=tower.RecoveryFloors:FindFirstChild("Recovery_"..floor*5)
		assert(model and model.CatchDeck.Size.X==108 and model.CatchDeck.Size.Z==108)
		assert(math.abs(model.CatchDeck.Position.Y+model.CatchDeck.Size.Y/2-Recovery.floorHeight(floor))<0.01)
		for section=0,9 do
			assert(PhysicsService:CollisionGroupsAreCollidable(Recovery.floorGroup(floor),Recovery.playerGroup(section))==Recovery.canStandOn(section,floor),"Incorrect recovery collision matrix")
		end
	end
	assert(game:GetService("Lighting").ClockTime==13.5,"Daylight settings missing")
	assert(tower:GetAttribute("Ready"))
	assert(#tower.Stages:GetChildren()==50)
	assert(#tower.CollectibleCoins:GetChildren()==100,"Missing map coins")
	local CoinRules=require(Shared.EconomyRules)
	for _,coin in tower.CollectibleCoins:GetChildren() do
		assert(CoinRules.validCoin(coin:GetAttribute("CoinId")),"Bad coin ID")
		assert(coin.Anchored and not coin.CanCollide and not coin.CanTouch,"Coins affect physics")
	end
	local templates=game:GetService("ServerStorage").TowerClubTemplates
	assert(#templates:GetChildren()==6,"Missing club models")
	local clubIds={}
	for _,tool in templates:GetChildren() do
		assert(tool:IsA("Tool") and tool.RequiresHandle and not tool.CanBeDropped,"Bad club tool")
		assert(tool:GetAttribute("TowerClub") and tool.Handle:IsA("BasePart"),"Club missing handle")
		assert(not clubIds[tool:GetAttribute("ClubId")],"Duplicate club template")
		clubIds[tool:GetAttribute("ClubId")]=true
		for _,part in tool:GetChildren() do
			if part:IsA("BasePart") then assert(not part.Anchored and part.Massless and not part.CanCollide and not part.CanQuery,"Club alters character collision/mass") end
		end
	end
	local remotes=game:GetService("ReplicatedStorage").Remotes
	assert(remotes.ClubAttack:IsA("RemoteEvent") and remotes.ClubSwing:IsA("RemoteEvent") and remotes.ClubHit:IsA("RemoteEvent"),"Club protocol missing")
	assert(remotes.ShopGetState:IsA("RemoteFunction") and remotes.ShopRequest:IsA("RemoteEvent"),"Shop protocol missing")
	assert(#tower.Checkpoints:GetChildren()==50)
	assert(#tower.RouteGates:GetChildren()==100)
	local count=0
	for _,model in game:GetService("CollectionService"):GetTagged("TowerMechanism") do
		if not model:IsDescendantOf(tower) then continue end
		count+=1
		local base=model:GetAttribute("Base")
		assert(typeof(base)=="CFrame")
		local safe=model:GetAttribute("Safe")
		local warning=model:GetAttribute("Warning")
		local active=model:GetAttribute("Active")
		local speed=model:GetAttribute("Speed")
		local phase=model:GetAttribute("Phase")
		assert(speed>0 and warning/speed>=1.2-0.00001,"Warning window too short")
		assert(safe/speed>=3.6-0.00001,"Safe window too short")
		for _,sample in {0.1,safe+warning*0.5,safe+warning+active*0.5} do
			local time=(sample-phase)/speed
			local first,state,danger=Motion.evaluate(model,time)
			assert(danger==(state=="active"),"Green or warning trap can damage player")
			local second=Motion.evaluate(model,time)
			assert(first==second,"Nondeterministic mechanism")
			assert(first.Position.X==first.Position.X,"NaN mechanism transform")
			if sample<safe then assert(state=="safe")
			elseif sample<safe+warning then assert(state=="warning")
			else assert(state=="active") end
		end
		if model:GetAttribute("Kind")=="blade" or model:GetAttribute("Kind")=="doubleRotor" then
			assert(math.abs(model.CrossSweep.Position.Y-model.Sweep.Position.Y)<0.001,"Unfair double-height blade")
			assert(Numeric.near(model.Sweep.Size.X,if model:GetAttribute("Kind")=="blade" then Geometry.BladeLength else Geometry.SweepLength),"Unsafe blade reach")
		end
		if model:GetAttribute("Stage")==15 then assert(safe/speed>=5.5-0.00001,"Stage 15 crossing window missing") end
		for _,part in model:GetDescendants() do
			if part:IsA("BasePart") then assert(part.Anchored,"Uncontrolled physics assembly") end
		end
	end
	assert(count==150,"Missing mechanism instances")
	for n=1,50 do
		local checkpoint=tower.Checkpoints:FindFirstChild("Checkpoint_"..n)
		assert(checkpoint:GetAttribute("Stage")==n)
		assert(checkpoint:IsA("SpawnLocation") and checkpoint.Enabled and checkpoint.CanTouch,"Broken respawn checkpoint")
		local spawn=checkpoint:GetAttribute("Spawn")
		assert(spawn.Position.Y>checkpoint.Position.Y+2)
		local stage=tower.Stages:FindFirstChild(string.format("Stage_%02d_%s",n,Definitions[n].Name))
		assert(stage and stage:GetAttribute("StageId")==n)
		assert(stage:GetAttribute("Traversal")==Definitions[n].Traversal,"Traversal variant missing")
		if Definitions[n].Traversal=="posts" then
			for node=1,11,2 do
				local post=stage:FindFirstChild("Post_"..node)
				assert(post and post.Shape==Enum.PartType.Cylinder,"Missing hop column")
				local _,top=Route.point(n,node,Definitions[n].Layout)
				assert(Numeric.near(post.Position.Y+post.Size.X/2,top),"Column top not aligned to route")
			end
		elseif Definitions[n].Traversal~="jumps" then
			local walking=stage:FindFirstChild("Traversal_"..Definitions[n].Traversal)
			assert(walking,"Missing walking route")
			local count=0
			for _,part in walking:GetChildren() do
				if part:IsA("BasePart") and part:GetAttribute("TraversalSurface") then
					count+=1
					assert(part.Anchored and part.CanCollide,"Nonphysical walking beam")
					assert(Numeric.near(part:GetAttribute("WalkWidth"),Traversal.width(Definitions[n])),"Wrong beam width")
				end
			end
			assert(count>=6,"Incomplete walking route")
		end
	end
	print("[StudioSmoke] PASS: generated hierarchy, daylight, 9 recovery floors, collision matrix, 50 respawn checkpoints, 150 mechanisms, timing and deterministic poses. Physics and persistence still need playtesting.")
	return true
end
return Test
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">0</token>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">TowerClient</string>
        </Properties>
        <Item class="LocalScript" referent="45">
          <Properties>
            <string name="Name">ClubController</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ContextActionService=game:GetService("ContextActionService")
local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local Debris=game:GetService("Debris")
local SoundService=game:GetService("SoundService")
local player=Players.LocalPlayer
local Catalog=require(ReplicatedStorage:WaitForChild("Shared").CosmeticCatalog)
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local current=nil
local activated=nil
local characterConnections={}
local gui=Instance.new("ScreenGui")
gui.Name="ClubStatus"; gui.ResetOnSpawn=false; gui.Parent=player:WaitForChild("PlayerGui")
local status=Instance.new("TextLabel")
status.AnchorPoint=Vector2.new(0.5,0.5)
status.Position=UDim2.fromScale(0.5,0.78)
status.Size=UDim2.new(0.75,0,0,38)
status.BackgroundTransparency=1
status.TextColor3=Color3.fromRGB(235,245,255)
status.TextStrokeTransparency=0.3
status.Font=Enum.Font.GothamBold
status.TextSize=14
status.TextWrapped=true
status.Visible=false
status.Parent=gui
local function refresh()
	local nextTool=nil
	local character=player.Character
	if character then
		for _,child in character:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("TowerClub") then nextTool=child; break end
		end
	end
	if nextTool==current then return end
	if activated then activated:Disconnect(); activated=nil end
	ContextActionService:UnbindAction("TowerClubAttack")
	current=nextTool
	status.Visible=current~=nil
	if not current then return end
	activated=current.Activated:Connect(function()
		if current and current.Parent==player.Character then remotes.ClubAttack:FireServer() end
	end)
	ContextActionService:BindAction("TowerClubAttack",function(_,inputState)
		if inputState==Enum.UserInputState.Begin and current then current:Activate() end
		return Enum.ContextActionResult.Sink
	end,true,Enum.KeyCode.F,Enum.KeyCode.ButtonR2)
	ContextActionService:SetTitle("TowerClubAttack","Удар")
	ContextActionService:SetPosition("TowerClubAttack",UDim2.fromScale(0.77,0.55))
end
local function bind(character)
	for _,connection in characterConnections do connection:Disconnect() end
	characterConnections={character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then table.insert(characterConnections,child:GetAttributeChangedSignal("TowerClub"):Connect(refresh)) end
		refresh()
	end),character.ChildRemoved:Connect(refresh)}
	refresh()
end
player.CharacterAdded:Connect(bind)
if player.Character then bind(player.Character) end
local elapsed=0
RunService.RenderStepped:Connect(function(dt)
	elapsed+=dt
	if elapsed<0.1 then return end
	elapsed=0
	if not current then return end
	local now=workspace:GetServerTimeNow()
	local shield=player:GetAttribute("ClubShieldUntil") or 0
	local cooldown=player:GetAttribute("ClubCooldownUntil") or 0
	if now<shield then status.Text="ЗАЩИТА · "..string.format("%.1f",shield-now).."с"
	elseif player:GetAttribute("ClubSafe") then status.Text="БЕЗОПАСНАЯ ЗОНА · УДАРЫ ОТКЛЮЧЕНЫ"
	elseif cooldown>now then status.Text=string.format("ПЕРЕЗАРЯДКА · %.1fс",cooldown-now)
	else status.Text="КЛИК / F / УДАР · ОТТОЛКНУТЬ ИГРОКА" end
end)
remotes.ClubSwing.OnClientEvent:Connect(function(userId,id)
	local attacker=Players:GetPlayerByUserId(userId)
	local character=attacker and attacker.Character
	local item=Catalog.ById[id]
	if not character or not item or item.Category~="Club" then return end
	local tool=nil
	for _,child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("ClubId")==id then tool=child; break end
	end
	if not tool then return end
	local rest=tool.Grip
	local animation=Instance.new("StringValue")
	animation.Name="toolanim"; animation.Value="Slash"; animation.Parent=tool
	Debris:AddItem(animation,1)
	TweenService:Create(tool,TweenInfo.new(item.Windup),{Grip=rest*CFrame.Angles(0,0,math.rad(-65))}):Play()
	task.delay(item.Windup,function()
		if not tool.Parent then return end
		TweenService:Create(tool,TweenInfo.new(0.12),{Grip=rest*CFrame.Angles(math.rad(75),0,math.rad(45))}):Play()
		task.delay(0.14,function() if tool.Parent then TweenService:Create(tool,TweenInfo.new(0.2),{Grip=rest}):Play() end end)
	end)
end)
remotes.ClubHit.OnClientEvent:Connect(function(_,_,position,id)
	local camera=workspace.CurrentCamera
	if camera and (camera.CFrame.Position-position).Magnitude>90 then return end
	local item=Catalog.ById[id]
	if not item then return end
	local anchor=Instance.new("Part")
	anchor.Size=Vector3.new(0.1,0.1,0.1); anchor.Position=position
	anchor.Transparency=1; anchor.Anchored=true
	anchor.CanCollide=false; anchor.CanTouch=false; anchor.CanQuery=false
	anchor.Parent=workspace
	local attachment=Instance.new("Attachment"); attachment.Parent=anchor
	local sparks=Instance.new("ParticleEmitter")
	sparks.Texture="rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color=ColorSequence.new(Color3.fromRGB(item.Color[1],item.Color[2],item.Color[3]))
	sparks.Enabled=false; sparks.Rate=0
	sparks.Speed=NumberRange.new(4,9); sparks.Lifetime=NumberRange.new(0.15,0.35)
	sparks.SpreadAngle=Vector2.new(180,180); sparks.Parent=attachment
	sparks:Emit(15)
	Debris:AddItem(anchor,1)
	local sound=Instance.new("Sound")
	sound.SoundId="rbxasset://sounds/electronicpingshort.wav"
	sound.PlaybackSpeed=0.6; sound.Volume=0.2; sound.Parent=SoundService
	sound:Play(); Debris:AddItem(sound,2)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="46">
          <Properties>
            <string name="Name">CoinController</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local tower=workspace:WaitForChild("GeneratedTower")
local folder=tower:WaitForChild("CollectibleCoins")
local player=Players.LocalPlayer
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local state=nil
local function update()
	local day=tower:GetAttribute("CoinDay")
	for _,coin in folder:GetChildren() do
		local collected=state and state.Day==day and state.Collected[coin:GetAttribute("CoinId")]
		coin.LocalTransparencyModifier=if collected then 1 else 0
	end
end
remotes.ShopStateChanged.OnClientEvent:Connect(function(value) if value.Ready and (not state or value.Revision>=state.Revision) then state=value; update() end end)
folder.ChildAdded:Connect(update)
tower:GetAttributeChangedSignal("CoinDay"):Connect(update)
task.spawn(function()
	if not player:GetAttribute("DataLoaded") then player:GetAttributeChangedSignal("DataLoaded"):Wait() end
	local ok,value=pcall(function() return remotes.ShopGetState:InvokeServer() end)
	if ok and value.Ready and (not state or value.Revision>=state.Revision) then state=value; update() end
end)
RunService.RenderStepped:Connect(function()
	local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local now=workspace:GetServerTimeNow()
	for _,coin in folder:GetChildren() do
		local base=coin:GetAttribute("Base")
		if base and coin.LocalTransparencyModifier<1 and math.abs(base.Position.Y-root.Position.Y)<55 then
			coin.CFrame=base*CFrame.Angles(0,now*1.6,0)+Vector3.new(0,math.sin(now*2)*0.2,0)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="47">
          <Properties>
            <string name="Name">CosmeticEffects</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Debris=game:GetService("Debris")
local Players=game:GetService("Players")
local Catalog=require(ReplicatedStorage:WaitForChild("Shared").CosmeticCatalog)
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local function color(rgb) return Color3.fromRGB(rgb[1],rgb[2],rgb[3]) end
remotes.CosmeticVictory.OnClientEvent:Connect(function(userId,cf,effectId)
	local item=Catalog.ById[effectId]
	if not item or item.Category~="Victory" then return end
	local camera=workspace.CurrentCamera
	if userId~=Players.LocalPlayer.UserId and camera and (camera.CFrame.Position-cf.Position).Magnitude>150 then return end
	local anchor=Instance.new("Part")
	anchor.Name="LocalVictoryEffect"
	anchor.Size=Vector3.new(0.1,0.1,0.1)
	anchor.CFrame=cf*CFrame.new(0,5,0)
	anchor.Anchored=true
	anchor.Transparency=1
	anchor.CanCollide=false; anchor.CanQuery=false; anchor.CanTouch=false
	anchor.Parent=workspace
	local attachment=Instance.new("Attachment")
	attachment.Parent=anchor
	local emitter=Instance.new("ParticleEmitter")
	emitter.Texture="rbxasset://textures/particles/sparkles_main.dds"
	emitter.Enabled=false
	emitter.Rate=0
	emitter.Color=ColorSequence.new(color(item.Color),color(item.SecondColor or {255,225,100}))
	emitter.Lifetime=NumberRange.new(1.5,3)
	emitter.Speed=NumberRange.new(12,24)
	emitter.SpreadAngle=Vector2.new(180,180)
	emitter.Acceleration=Vector3.new(0,-15,0)
	emitter.LightEmission=0.8
	emitter.Size=NumberSequence.new(if effectId=="fx_prism" then 0.5 else 0.3,0)
	emitter.Parent=attachment
	Debris:AddItem(anchor,7)
	for burst=1,4 do emitter:Emit(if effectId=="fx_default" then 65 else 90); task.wait(0.4) end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="48">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Debris=game:GetService("Debris")
local SoundService=game:GetService("SoundService")
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local function chime(pitch)
	local sound=Instance.new("Sound")
	sound.SoundId="rbxasset://sounds/electronicpingshort.wav"
	sound.Volume=0.35
	sound.PlaybackSpeed=pitch
	sound.Parent=SoundService
	sound:Play()
	Debris:AddItem(sound,3)
end
remotes.CheckpointNotification.OnClientEvent:Connect(function() chime(1.15) end)
remotes.VictoryEvent.OnClientEvent:Connect(function()
	chime(0.8)
end)
-- Local proximity warnings: a single scheduler, no per-part sound loops.
local CollectionService=game:GetService("CollectionService")
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local tower=workspace:WaitForChild("GeneratedTower")
local lastStates={}
local elapsed=0
local lastSound=0
RunService.Heartbeat:Connect(function(dt)
	elapsed+=dt
	if elapsed<0.15 then return end
	elapsed=0
	local character=Players.LocalPlayer.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	for _,model in CollectionService:GetTagged("TowerMechanism") do
		if not model:IsDescendantOf(tower) then continue end
		local state=model:GetAttribute("VisualState")
		if state~=lastStates[model] then
			lastStates[model]=state
			if state=="warning" and (root.Position-model:GetAttribute("Base").Position).Magnitude<25 then
				if model:GetAttribute("SoundEnabled") and os.clock()-lastSound>0.4 then chime(0.6); lastSound=os.clock() end
				local sparks=model:FindFirstChild("WarningSparks",true)
				if sparks then sparks:Emit(6) end
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="49">
          <Properties>
            <string name="Name">HUDController</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Config=require(ReplicatedStorage:WaitForChild("Shared").GameConfig)
local player=Players.LocalPlayer
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local tower=workspace:WaitForChild("GeneratedTower")
local checkpointFolder=tower:WaitForChild("Checkpoints")
local gui=Instance.new("ScreenGui")
gui.Name="MechanicalTowerHUD"
gui.ResetOnSpawn=false
gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
gui.Parent=player:WaitForChild("PlayerGui")
local function round(object,radius)
	local corner=Instance.new("UICorner")
	corner.CornerRadius=UDim.new(0,radius)
	corner.Parent=object
end
local function label(parent,name,text,position,size,fontSize,color)
	local object=Instance.new("TextLabel")
	object.Name=name
	object.BackgroundTransparency=1
	object.Position=position
	object.Size=size
	object.Font=Enum.Font.GothamBold
	object.TextSize=fontSize
	object.TextColor3=color or Color3.fromRGB(235,242,255)
	object.TextXAlignment=Enum.TextXAlignment.Left
	object.Text=text
	object.Parent=parent
	return object
end
local panel=Instance.new("Frame")
panel.Name="ProgressPanel"
panel.Position=UDim2.fromOffset(14,12)
panel.Size=UDim2.fromOffset(360,182)
panel.BackgroundColor3=Color3.fromRGB(16,22,34)
panel.BackgroundTransparency=0.08
panel.Parent=gui
round(panel,14)
local scale=Instance.new("UIScale")
scale.Parent=panel
local border=Instance.new("UIStroke")
border.Color=Config.ZoneColors[1]
border.Transparency=0.35
border.Parent=panel
label(panel,"Title","MEGA / MECHANICAL TOWER",UDim2.fromOffset(18,12),UDim2.fromOffset(326,20),13,Config.ZoneColors[1])
local zone=label(panel,"Zone","LOADING…",UDim2.fromOffset(18,36),UDim2.fromOffset(326,18),12,Color3.fromRGB(150,169,191))
local stageText=label(panel,"Stage","Stage: 0 / 50",UDim2.fromOffset(18,61),UDim2.fromOffset(326,30),25)
local track=Instance.new("Frame")
track.Size=UDim2.fromOffset(324,8)
track.Position=UDim2.fromOffset(18,104)
track.BackgroundColor3=Color3.fromRGB(43,53,70)
track.ClipsDescendants=true
track.Parent=panel
round(track,4)
local fill=Instance.new("Frame")
fill.Name="Progress"
fill.Size=UDim2.fromScale(0,1)
fill.BackgroundColor3=Config.ZoneColors[1]
fill.BorderSizePixel=0
fill.Parent=track
round(fill,4)
local stats=label(panel,"Stats","Deaths: 0     Time: 00:00",UDim2.fromOffset(18,123),UDim2.fromOffset(326,22),14)
local status=label(panel,"SaveStatus","",UDim2.fromOffset(18,150),UDim2.fromOffset(326,18),11,Color3.fromRGB(150,169,191))
local toast=label(gui,"CheckpointToast","",UDim2.fromScale(0.5,0.24),UDim2.fromScale(0.86,0.09),25)
toast.AnchorPoint=Vector2.new(0.5,0.5)
toast.TextXAlignment=Enum.TextXAlignment.Center
toast.TextScaled=true
toast.TextStrokeTransparency=0.25
toast.Visible=false
local toastConstraint=Instance.new("UITextSizeConstraint")
toastConstraint.MaxTextSize=28
toastConstraint.MinTextSize=12
toastConstraint.Parent=toast
local victory=Instance.new("Frame")
victory.Name="VictoryGui"
victory.AnchorPoint=Vector2.new(0.5,0.5)
victory.Position=UDim2.fromScale(0.5,0.55)
victory.Size=UDim2.fromScale(0.86,0.7)
victory.BackgroundColor3=Color3.fromRGB(15,22,37)
victory.Visible=false
victory.Parent=gui
round(victory,20)
local aspect=Instance.new("UIAspectRatioConstraint")
aspect.AspectRatio=1.5
aspect.DominantAxis=Enum.DominantAxis.Width
aspect.Parent=victory
local sizeLimit=Instance.new("UISizeConstraint")
sizeLimit.MaxSize=Vector2.new(540,360)
sizeLimit.Parent=victory
local winTitle=label(victory,"WinTitle","YOU WIN!",UDim2.fromScale(0.07,0.1),UDim2.fromScale(0.86,0.18),40,Config.ZoneColors[5])
winTitle.TextScaled=true
winTitle.TextXAlignment=Enum.TextXAlignment.Center
local winInfo=label(victory,"WinInfo","",UDim2.fromScale(0.08,0.34),UDim2.fromScale(0.84,0.25),19)
winInfo.TextScaled=true
winInfo.TextWrapped=true
winInfo.TextXAlignment=Enum.TextXAlignment.Center
local replay=Instance.new("TextButton")
replay.Name="PlayAgain"
replay.Size=UDim2.fromScale(0.7,0.18)
replay.Position=UDim2.fromScale(0.15,0.69)
replay.BackgroundColor3=Config.ZoneColors[5]
replay.TextColor3=Color3.fromRGB(12,25,35)
replay.Font=Enum.Font.GothamBold
replay.Text="Play Again"
replay.TextScaled=true
replay.Parent=victory
round(replay,10)
replay.Activated:Connect(function() remotes.PlayAgain:FireServer() end)
local function formatTime(seconds)
	seconds=math.max(0,math.floor(seconds))
	return string.format("%02d:%02d",math.floor(seconds/60),seconds%60)
end
local progressTween
local function update()
	local stage=player:GetAttribute("RunStage") or 0
	local maximum=player:GetAttribute("MaxStage") or 0
	local zoneId=math.clamp(math.ceil(math.max(1,stage+1)/10),1,5)
	local color=Config.ZoneColors[zoneId]
	stageText.Text=string.format("Stage: %d / 50%s",stage,if player:GetAttribute("Completed") then "  ★" else "")
	zone.Text=Config.ZoneNames[zoneId].."  /  BEST "..maximum.." OF 50"
	zone.TextColor3=color
	border.Color=color
	fill.BackgroundColor3=color
	if progressTween then progressTween:Cancel() end
	progressTween=TweenService:Create(fill,TweenInfo.new(0.4,Enum.EasingStyle.Quad),{Size=UDim2.fromScale(stage/50,1)})
	progressTween:Play()
	status.Text=if not player:GetAttribute("DataLoaded") then "Loading progress…"
		elseif not player:GetAttribute("Persistence") then string.format("Respawn: %d · Safety floor: %d · Studio session",stage,player:GetAttribute("RecoveryStage") or 0)
		elseif player:GetAttribute("SavePending") then "Saving progress…" else string.format("Saved · Respawn: %d · Safety floor: %d",stage,player:GetAttribute("RecoveryStage") or 0)
	victory.Visible=player:GetAttribute("Won")==true
	local finishTime=player:GetAttribute("FinishTime")
	winInfo.Text=if finishTime then "50 / 50 · MASTER MECHANIC\n"..(if player:GetAttribute("FullRun") then "Full run: " else "Session time: ")..formatTime(finishTime).."\nMaximum progress is preserved."
		else "50 / 50 · MASTER MECHANIC\nWelcome back to the crown!\nPlay again without losing your record."
	-- Local color changes are personal: one player's touch never recolors another player's progress.
	for _,cp in checkpointFolder:GetChildren() do
		cp.Color=if cp:GetAttribute("Stage")<=stage then Color3.fromRGB(65,255,155) else Config.ZoneColors[math.ceil(cp:GetAttribute("Stage")/10)]
	end
end
for _,attribute in {"DataLoaded","RunStage","MaxStage","Won","Completed","SavePending","Persistence","FinishTime","Deaths","RecoveryStage"} do
	player:GetAttributeChangedSignal(attribute):Connect(update)
end
local function resize()
	local camera=workspace.CurrentCamera
	if camera then scale.Scale=math.clamp(math.min(camera.ViewportSize.X/600,camera.ViewportSize.Y/600),0.62,1) end
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(resize)
local timerAccumulator=0
RunService.RenderStepped:Connect(function(dt)
	timerAccumulator+=dt
	if timerAccumulator<0.1 then return end
	timerAccumulator=0
	resize()
	local started=player:GetAttribute("StartedAt") or workspace:GetServerTimeNow()
	local duration=player:GetAttribute("FinishTime") or (workspace:GetServerTimeNow()-started)
	stats.Text=string.format("Deaths: %d     Time: %s",player:GetAttribute("Deaths") or 0,formatTime(duration))
end)
local toastVersion=0
remotes.CheckpointNotification.OnClientEvent:Connect(function(stage)
	toastVersion+=1
	local version=toastVersion
	toast.Text="Checkpoint "..stage.."/50"
	toast.TextColor3=Config.ZoneColors[math.ceil(stage/10)]
	toast.Visible=true
	task.delay(2.5,function() if toastVersion==version then toast.Visible=false end end)
end)
checkpointFolder.ChildAdded:Connect(update)
update()
resize()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="50">
          <Properties>
            <string name="Name">MechanismClient</string>
            <string name="Source"><![CDATA[--!strict
-- Anchored mechanisms use the same server clock on both peers. Only the owning
-- client carries its character; the server never applies a second displacement.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local CollectionService=game:GetService("CollectionService")
local Motion=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").TrapMotion)
local player=Players.LocalPlayer
local tower=workspace:WaitForChild("GeneratedTower")
local records={}
local byModel={}
local function add(model)
	if byModel[model] or not model:IsDescendantOf(tower) then return end
	local record={model=model,previous=nil,delta=CFrame.identity}
	table.insert(records,record)
	byModel[model]=record
end
CollectionService:GetInstanceAddedSignal("TowerMechanism"):Connect(add)
CollectionService:GetInstanceRemovedSignal("TowerMechanism"):Connect(function(model)
	local record=byModel[model]
	if not record then return end
	byModel[model]=nil
	local index=table.find(records,record)
	if index then table.remove(records,index) end
end)
for _,model in CollectionService:GetTagged("TowerMechanism") do add(model) end
local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Exclude
RunService.PreSimulation:Connect(function(dt)
	local character=player.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end
	local now=workspace:GetServerTimeNow()
	for _,record in records do
		local model=record.model
		if math.abs(root.Position.Y-model:GetAttribute("Base").Position.Y)>140 then
			record.previous=nil
			continue
		end
		local _,_,danger=Motion.evaluate(model,now)
		Motion.apply(model,now)
		local current=model:GetPivot()
		record.delta=if record.previous then current*record.previous:Inverse() else CFrame.identity
		record.previous=current
		if model:GetAttribute("Motion")=="gate" then
			for _,p in model:GetChildren() do
				if p:IsA("BasePart") and p:GetAttribute("Hazard") then
					p.Transparency=if danger then 0.05 elseif model:GetAttribute("VisualState")=="warning" then 0.65 else 0.95
				end
			end
		end
	end
	if workspace:GetServerTimeNow()<(root:GetAttribute("ClubKnockbackUntil") or 0) then return end
	if humanoid.Health<=0 or humanoid:GetState()==Enum.HumanoidStateType.Jumping then return end
	rayParams.FilterDescendantsInstances={character}
	rayParams.CollisionGroup=root.CollisionGroup
	local distance=humanoid.HipHeight+root.Size.Y/2+0.65
	local hit=workspace:Raycast(root.Position,Vector3.new(0,-distance,0),rayParams)
	if not hit or hit.Normal.Y<0.5 or not hit.Instance:GetAttribute("Carry") then return end
	-- A ground ray alone must not catch falling characters early or cancel a jump.
	if root.AssemblyLinearVelocity.Y>8 or root.AssemblyLinearVelocity.Y < -12 then return end
	local model=hit.Instance:FindFirstAncestorOfClass("Model")
	local record=model and byModel[model]
	if not record then return end
	local displacement=record.delta
	if model:GetAttribute("Motion")=="belt" then
		displacement=CFrame.new(model:GetAttribute("Base"):VectorToWorldSpace(model:GetAttribute("Direction"))*model:GetAttribute("BeltSpeed")*math.min(dt,0.05))*displacement
	end
	root.CFrame=displacement*root.CFrame
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="51">
          <Properties>
            <string name="Name">RecoveryController</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local player=Players.LocalPlayer
local floors=workspace:WaitForChild("GeneratedTower"):WaitForChild("RecoveryFloors")
local function update()
	local unlocked=player:GetAttribute("RecoveryStage") or 0
	for _,model in floors:GetChildren() do
		local active=unlocked>=(model:GetAttribute("UnlockStage") or math.huge)
		for _,object in model:GetDescendants() do
			if object:IsA("BasePart") then
				-- Locked floors are pass-through for this character and shown as ghosts.
				object.LocalTransparencyModifier=if active then 0 else 0.94
			elseif object:IsA("BillboardGui") then object.Enabled=active end
		end
	end
end
player:GetAttributeChangedSignal("RecoveryStage"):Connect(update)
floors.DescendantAdded:Connect(update)
update()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">ShopController</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Catalog=require(ReplicatedStorage:WaitForChild("Shared").CosmeticCatalog)
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui")
gui.Name="CosmeticShop"
gui.ResetOnSpawn=false
gui.DisplayOrder=10
gui.Parent=player:WaitForChild("PlayerGui")
local function rounded(object)
	local corner=Instance.new("UICorner")
	corner.CornerRadius=UDim.new(0,10)
	corner.Parent=object
end
local function text(parent,value,position,size,fontSize)
	local label=Instance.new("TextLabel")
	label.BackgroundTransparency=1
	label.Text=value
	label.Position=position
	label.Size=size
	label.Font=Enum.Font.GothamBold
	label.TextColor3=Color3.fromRGB(235,242,255)
	label.TextSize=fontSize
	label.TextXAlignment=Enum.TextXAlignment.Left
	label.TextWrapped=true
	label.Parent=parent
	return label
end
local function button(parent,value,position,size)
	local b=Instance.new("TextButton")
	b.Text=value
	b.Position=position
	b.Size=size
	b.Font=Enum.Font.GothamBold
	b.TextSize=14
	b.TextColor3=Color3.fromRGB(15,24,36)
	b.BackgroundColor3=Color3.fromRGB(95,225,245)
	b.Parent=parent
	rounded(b)
	return b
end
local open=button(gui,"◉ 0\nМАГАЗИН",UDim2.new(1,-12,0,12),UDim2.fromOffset(130,60))
open.AnchorPoint=Vector2.new(1,0)
local openScale=Instance.new("UIScale")
openScale.Parent=open
local function resize()
	local camera=workspace.CurrentCamera
	if camera then openScale.Scale=math.clamp(camera.ViewportSize.X/600,0.75,1) end
end
local viewportConnection
local function bindCamera()
	if viewportConnection then viewportConnection:Disconnect() end
	if workspace.CurrentCamera then viewportConnection=workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
	resize()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
bindCamera()
local panel=Instance.new("Frame")
panel.AnchorPoint=Vector2.new(0.5,0.5)
panel.Position=UDim2.fromScale(0.5,0.52)
panel.Size=UDim2.fromScale(0.92,0.82)
panel.BackgroundColor3=Color3.fromRGB(17,24,38)
panel.Visible=false
panel.Parent=gui
rounded(panel)
local limit=Instance.new("UISizeConstraint")
limit.MaxSize=Vector2.new(720,600)
limit.Parent=panel
text(panel,"МАГАЗИН • ДУБИНКИ И СТИЛЬ",UDim2.fromOffset(14,8),UDim2.new(1,-60,0,26),16)
local close=button(panel,"×",UDim2.new(1,-43,0,8),UDim2.fromOffset(32,28))
close.Activated:Connect(function() panel.Visible=false end)
local balance=text(panel,"Загрузка монет…",UDim2.fromOffset(14,37),UDim2.new(1,-28,0,24),14)
local hint=text(panel,"Монеты: на маршруте, за этапы и первую победу",UDim2.fromOffset(14,62),UDim2.new(1,-28,0,20),11)
hint.TextColor3=Color3.fromRGB(155,175,195)
local tabs=Instance.new("Frame")
tabs.BackgroundTransparency=1
tabs.Position=UDim2.fromOffset(12,89)
tabs.Size=UDim2.new(1,-24,0,32)
tabs.Parent=panel
local scroll=Instance.new("ScrollingFrame")
scroll.BackgroundTransparency=1
scroll.BorderSizePixel=0
scroll.Position=UDim2.fromOffset(12,132)
scroll.Size=UDim2.new(1,-24,1,-144)
scroll.ScrollBarThickness=5
scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
scroll.CanvasSize=UDim2.new()
scroll.Parent=panel
local layout=Instance.new("UIListLayout")
layout.Padding=UDim.new(0,8)
layout.SortOrder=Enum.SortOrder.LayoutOrder
layout.Parent=scroll
local notice=text(gui,"",UDim2.fromScale(0.5,0.83),UDim2.fromScale(0.88,0.1),17)
notice.AnchorPoint=Vector2.new(0.5,0)
notice.TextXAlignment=Enum.TextXAlignment.Center
notice.TextStrokeTransparency=0.25
notice.Visible=false
local state=nil
local category="Club"
local tabButtons={}
local function card(name,description,color,actionText,enabled,callback)
	local row=Instance.new("Frame")
	row.Name="Card"
	row.Size=UDim2.new(1,-8,0,84)
	row.BackgroundColor3=Color3.fromRGB(31,42,59)
	row.Parent=scroll
	row.LayoutOrder=#scroll:GetChildren()
	rounded(row)
	local nameLabel=text(row,name,UDim2.fromOffset(12,8),UDim2.new(1,-147,0,28),16)
	nameLabel.TextColor3=color
	text(row,description,UDim2.fromOffset(12,38),UDim2.new(1,-147,0,36),11)
	local b=button(row,actionText,UDim2.new(1,-130,0.5,-20),UDim2.fromOffset(118,40))
	b.TextWrapped=true
	b.Active=enabled
	b.AutoButtonColor=enabled
	if not enabled then b.BackgroundColor3=Color3.fromRGB(99,114,134) end
	if enabled then b.Activated:Connect(callback) end
end
local function render()
	for _,child in scroll:GetChildren() do if child:IsA("Frame") then child:Destroy() end end
	for id,b in tabButtons do b.BackgroundColor3=if id==category then Color3.fromRGB(95,225,245) else Color3.fromRGB(135,155,175) end
	if not state or not state.Ready then balance.Text="Загрузка монет…"; return end
	open.Text="◉ "..state.Coins.."\nМАГАЗИН"
	balance.Text="◉ "..state.Coins..(if state.Persistent then " монет" else " монет · Studio: только эта сессия")
	if category=="Donate" then
		hint.Text="Наборы монет и постоянные Game Pass-дубинки"
		for _,product in state.Products do
			local owned=product.ItemId and state.Owned[product.ItemId]
			local description=if product.Type=="Pass" then "Дубинка навсегда + титул поддержки. Цена в окне Roblox."
				else "Монеты на косметику и дубинки. Цена в окне Roblox."
			card(product.Name,description,Color3.fromRGB(255,210,80),
				if owned then "Куплено" elseif product.Enabled then "Купить за Robux" else "Скоро",product.Enabled and not owned,function() remotes.ShopRequest:FireServer("donate",product.Key) end)
		end
	else
		hint.Text=if category=="Club" then "Вне безопасных зон · без прямого урона · пауза между ударами" else "Следы, титулы и эффекты не усиливают персонажа"
		for _,item in Catalog.Items do
			if item.Category~=category then continue end
			local owned=state.Owned[item.Id]
			local equipped=state.Equipped[category]==item.Id
			local passOffer=nil
			if item.RequiredPass then for _,offer in state.Products do if offer.Key==item.RequiredPass and offer.Type=="Pass" then passOffer=offer; break end end end
			local locked=(item.RequiredWin and not state.WinRewarded) or (item.RequiredSupport and not state.Supporter)
			local description=if item.Category=="Club" then string.format("Отброс %d • Дальность %.1f • Пауза %.2fс",item.Power,item.Range,item.Cooldown)
				elseif item.RequiredWin then "За первую победу на 50-м этапе"
				elseif item.RequiredSupport then "В подарок за любой набор поддержки"
				elseif owned then "Есть в вашей коллекции" else "Постоянный косметический предмет"
			local enabled=not equipped and not locked
			local action=if equipped then "Выбрано" elseif locked then "Закрыто" elseif owned then "Надеть" else "◉ "..item.Price
			if item.RequiredPass and not owned then
				enabled=passOffer~=nil and passOffer.Enabled
				action=if enabled then "За Robux" else "Скоро"
			end
			card(item.Name,description,Color3.fromRGB(item.Color[1],item.Color[2],item.Color[3]),action,enabled,function()
				if item.RequiredPass and not owned then remotes.ShopRequest:FireServer("donate",item.RequiredPass)
				else remotes.ShopRequest:FireServer(if owned then "equip" else "buy",item.Id) end
			end)
		end
	end
end
for i,entry in {{"Club","Дубинки"},{"Trail","Следы"},{"Victory","Победа"},{"Title","Титулы"},{"Donate","Донат"}} do
	local b=button(tabs,entry[2],UDim2.new((i-1)/5,3,0,0),UDim2.new(0.2,-6,1,0))
	b.TextSize=12
	tabButtons[entry[1]]=b
	b.Activated:Connect(function() category=entry[1]; render() end)
end
local function accept(value)
	if not value.Ready then return end
	if state and value.Revision<state.Revision then return end
	state=value
	render()
end
local function refresh()
	task.spawn(function()
		local ok,value=pcall(function() return remotes.ShopGetState:InvokeServer() end)
		if ok then accept(value) end
	end)
end
open.Activated:Connect(function() panel.Visible=not panel.Visible; if panel.Visible then refresh() end end)
remotes.ShopStateChanged.OnClientEvent:Connect(accept)
player:GetAttributeChangedSignal("Coins"):Connect(function() open.Text="◉ "..(player:GetAttribute("Coins") or 0).."\nМАГАЗИН" end)
player:GetAttributeChangedSignal("DataLoaded"):Connect(refresh)
local noticeVersion=0
remotes.ShopNotice.OnClientEvent:Connect(function(message)
	noticeVersion+=1
	local version=noticeVersion
	notice.Text=message
	notice.Visible=true
	task.delay(3,function() if version==noticeVersion then notice.Visible=false end end)
end)
refresh()
render()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="53">
          <Properties>
            <string name="Name">StartupController</string>
            <string name="Source"><![CDATA[--!strict
-- Independent of Shared, Remotes and GeneratedTower: visible even when one of
-- those fails to initialize. This script never grants progress or spawns players.
local Players=game:GetService("Players")
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui")
gui.Name="TowerStartupStatus"
gui.ResetOnSpawn=false
gui.DisplayOrder=100
gui.Parent=player:WaitForChild("PlayerGui")
local label=Instance.new("TextLabel")
label.AnchorPoint=Vector2.new(0.5,0.5)
label.Position=UDim2.fromScale(0.5,0.48)
label.Size=UDim2.fromScale(0.85,0.28)
label.BackgroundColor3=Color3.fromRGB(16,24,37)
label.BackgroundTransparency=0.06
label.TextColor3=Color3.fromRGB(175,235,255)
label.Font=Enum.Font.GothamBold
label.TextSize=20
label.TextScaled=true
label.TextWrapped=true
label.Parent=gui
local textLimit=Instance.new("UITextSizeConstraint")
textLimit.MinTextSize=12
textLimit.MaxTextSize=20
textLimit.Parent=label
local padding=Instance.new("UIPadding")
padding.PaddingTop=UDim.new(0,12)
padding.PaddingBottom=UDim.new(0,12)
padding.PaddingLeft=UDim.new(0,16)
padding.PaddingRight=UDim.new(0,16)
padding.Parent=label
local corner=Instance.new("UICorner")
corner.CornerRadius=UDim.new(0,12)
corner.Parent=label
local messages={
	starting="Запускаем башню…",modules="Загружаем модули игры…",
	generating="Строим 50 этапов и страховочные этажи…",services="Запускаем ловушки и чекпоинты…",
	ready="Загружаем прогресс и персонажа…",
}
local function update()
	local status=workspace:GetAttribute("TowerBootStatus")
	if status=="ready" and player:GetAttribute("DataLoaded") then
		gui.Enabled=false
		return
	end
	gui.Enabled=true
	if status=="failed" then
		local detail=tostring(workspace:GetAttribute("TowerBootError") or "Unknown error")
		detail=string.match(detail,"[^\n]+") or detail
		label.TextColor3=Color3.fromRGB(255,150,130)
		label.Text="Ошибка запуска игры\n"..string.sub(detail,1,220).."\nОткройте View → Output и скопируйте сообщение [Tower] STARTUP FAILED."
	else
		label.Text=messages[status] or "Подключаемся к серверу…"
	end
end
workspace:GetAttributeChangedSignal("TowerBootStatus"):Connect(update)
workspace:GetAttributeChangedSignal("TowerBootError"):Connect(update)
player:GetAttributeChangedSignal("DataLoaded"):Connect(update)
update()
task.delay(20,function()
	if gui.Enabled and workspace:GetAttribute("TowerBootStatus")~="failed" then
		label.Text..="\nЕсли ожидание продолжается, откройте View → Output и проверьте сообщения сервера."
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="54">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-150</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>