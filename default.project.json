      "$properties": {
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -150,
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 13.5,
        "Brightness": 3.2,
        "Ambient": [
          0.65,
          0.69,
          0.76
        ],
        "OutdoorAmbient": [
          0.76,
          0.8,
          0.86
        ],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 0.5,
        "GlobalShadows": false
      }
    },
    "ServerStorage": {
      "TowerTests": {
        "$path": "tests/studio"
      }
    }
  }
}
