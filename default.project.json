{
  "name": "MEGA MECHANICAL TOWER — 50 STAGES",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "TowerServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 50,
